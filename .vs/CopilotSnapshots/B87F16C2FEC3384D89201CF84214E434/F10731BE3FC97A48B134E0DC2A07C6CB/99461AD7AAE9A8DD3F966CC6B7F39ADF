<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Contact — AM Global</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="Contact Alfred Anate Bodurin Mayaki — enquiries, collaborations and community work." />
  <meta name="author" content="Alfred Anate Bodurin Mayaki" />

  <!-- Font Awesome (icons for social links) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />

  <style>
    :root{
      --font-sans: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
      --bg-overlay: rgba(22,22,22,0.92);
      --panel: #161616;
      --surface: #2a2a2a;
      --text: #ffffff;
      --text-muted: #979797;
      --text-secondary: #b0b0b0;
      --border: #464242;
      --brand: #3d4ee9;
      --brand-hover: #5563f0;
      --radius-md: 14px;
      --radius-lg: 18px;
      --shadow-pop: 0 10px 30px rgba(0,0,0,0.6);
      --shadow-brand: 0 10px 30px rgba(61,78,233,0.12);
      --transition-fast: 180ms;
      --transition-med: 300ms;
    }

    html {
      /* Use unified opaque background to avoid background-image bleed */
      background: var(--footer-bg, #000000);
      min-height: 100vh;
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-sans);
      /* match opaque site background for consistent contrast */
      background: var(--footer-bg, #000000);
      color: var(--text-muted);
      line-height: 1.6;
      font-size: 16px;
      max-width: 990px;
      margin: 2em auto;
      padding: 2em;
      border: 3px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-pop);
      box-sizing: border-box;
    }

    /* ---------- Top navigation with hamburger dropdown ---------- */
    .top-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      max-width: 980px;
      margin: 0 auto 1.25rem;
      padding: 0.45rem 0.6rem;
      background: transparent;
      box-sizing: border-box;
      position: relative;
    }
    .top-nav .brand {
      color: var(--text);
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.98rem;
      z-index: 10;
    }
    .top-nav .brand:link,
    .top-nav .brand:visited,
    .top-nav .brand:hover,
    .top-nav .brand:active {
      color: var(--text);
      text-decoration: none;
    }
    /* Hamburger menu button */
    .menu-toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      width: 44px;
      height: 44px;
      padding: 0.5rem;
      background: var(--surface);
      border: 2px solid var(--border);
      border-radius: 10px;
      cursor: pointer;
      transition: background var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
      z-index: 10;
    }
    .menu-toggle:hover,
    .menu-toggle:focus {
      background: rgba(61,78,233,0.08);
      border-color: var(--brand);
      box-shadow: var(--shadow-brand);
      outline: none;
    }
    .menu-toggle .bar {
      width: 20px;
      height: 2px;
      background: var(--text);
      margin: 2px 0;
      border-radius: 2px;
      transition: transform var(--transition-fast), opacity var(--transition-fast);
    }
    .menu-toggle.open .bar:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .menu-toggle.open .bar:nth-child(2) { opacity: 0; }
    .menu-toggle.open .bar:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
    /* Dropdown menu box */
    .nav-dropdown {
      position: absolute;
      top: 100%;
      right: 0;
      min-width: 200px;
      background: var(--panel);
      border: 2px solid var(--brand);
      border-radius: 12px;
      padding: 0.5rem;
      box-shadow: 0 12px 40px rgba(0,0,0,0.5), var(--shadow-brand);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity var(--transition-med), transform var(--transition-med), visibility var(--transition-med);
      z-index: 100;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .nav-dropdown.open {
      opacity: 1;
      visibility: visible;
      transform: translateY(8px);
    }
    .nav-dropdown a {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-secondary);
      text-decoration: none;
      padding: 0.65rem 0.9rem;
      border-radius: 8px;
      font-size: 0.95rem;
      transition: background var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
    }
    .nav-dropdown a:hover,
    .nav-dropdown a:focus {
      background: rgba(61,78,233,0.12);
      color: var(--text);
      transform: translateX(4px);
      outline: none;
    }
    .nav-dropdown a[aria-current="page"] {
      background: rgba(61,78,233,0.15);
      color: var(--brand);
      font-weight: 600;
    }
    .nav-dropdown .menu-label {
      color: var(--text-muted);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.4rem 0.9rem 0.2rem;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      margin-bottom: 0.25rem;
    }
    @media (max-width: 600px) {
      .top-nav { padding: 0.4rem; }
      .nav-dropdown { right: 0; left: 0; min-width: auto; margin: 0 0.4rem; }
    }

    .page-title { text-align:center; color:var(--text); font-size:1.25rem; font-weight:700; margin:0.75rem 0 0.6rem; }
    .page-subtitle { color:#9b9b9b; font-family:Arial,Helvetica,sans-serif; text-align:center; margin:0.25rem 0 1rem; font-weight:600; }

    .container {
      max-width: 920px;
      margin: 1.25rem auto;
      background: rgba(255,255,255,0.02);
      border-radius: 12px;
      padding: 1.25rem;
      color: var(--text-secondary);
      box-sizing: border-box;
      border-left: 4px solid transparent;
      transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    }

    .container:hover {
      border-left-color: var(--brand);
      box-shadow: var(--shadow-brand);
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      align-items: start;
    }
    @media (max-width: 760px) {
      .grid { grid-template-columns: 1fr; }
    }

    .contact-info {
      padding: 0.75rem;
      border-radius: 10px;
      background: linear-gradient(180deg, rgba(255,255,255,0.01), transparent);
      border: 1px solid rgba(255,255,255,0.03);
    }
    .contact-info h3 { margin: 0 0 0.35rem 0; color: var(--text); font-size: 1rem; }
    .contact-info p { margin: 0.35rem 0; color: var(--text-secondary); }

    /* Form */
    form.contact-form {
      padding: 0.75rem;
      border-radius: 10px;
      background: linear-gradient(180deg, rgba(255,255,255,0.01), transparent);
      border: 1px solid rgba(255,255,255,0.03);
      display:flex;
      flex-direction:column;
      gap:0.6rem;
    }

    label { font-size: 0.9rem; color: var(--text); display:block; margin-bottom:0.25rem; }
    .input, textarea {
      width:100%;
      padding:0.7rem 0.85rem;
      background: var(--surface);
      color: var(--text);
      border: 1px solid rgba(255,255,255,0.04);
      border-radius: 10px;
      font-size: 0.95rem;
      box-sizing: border-box;
      resize: vertical;
    }
    textarea { min-height: 140px; }

    .row {
      display:flex;
      gap:0.6rem;
    }
    .row .col { flex:1; }

    .note { color: var(--text-secondary); font-size:0.95rem; }

    .actions {
      display:flex;
      gap:0.6rem;
      align-items:center;
      margin-top:0.25rem;
    }

    .btn {
      padding: 0.6rem 0.95rem;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      background: var(--brand);
      color: #fff;
      font-weight:600;
      transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
      will-change: transform, box-shadow;
    }
    .btn[disabled] { opacity: 0.6; cursor: default; transform:none; box-shadow: none; }
    .btn.secondary {
      background: transparent;
      color: var(--text);
      border: 1px solid rgba(255,255,255,0.06);
    }

    /* Hover / focus / active states for send button (responsive to cursor) */
    .btn:not([disabled]):hover,
    .btn:not([disabled]):focus {
      transform: translateY(-3px);
      box-shadow: var(--shadow-brand);
      background: var(--brand-hover);
    }
    .btn.secondary:not([disabled]):hover,
    .btn.secondary:not([disabled]):focus {
      background: rgba(255,255,255,0.03);
      color: var(--text);
      box-shadow: var(--shadow-brand);
      transform: translateY(-2px);
    }
    .btn:active { transform: translateY(-1px); }
    .btn:focus-visible {
      outline: 3px solid rgba(61,78,233,0.18);
      outline-offset: 3px;
    }

    .thankyou {
      padding: 0.8rem;
      border-radius: 10px;
      background: linear-gradient(180deg, rgba(61,78,233,0.06), rgba(61,78,233,0.03));
      color: var(--text);
      font-weight: 600;
      text-align: center;
    }

    .soft-separator { border:none; height:1px; margin:1.5rem 0; width:100%; background: linear-gradient(90deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02)); opacity:0.85; }

    /* Social links (Font Awesome) */
    .social-links {
      display:flex;
      gap:0.5rem;
      margin-top:0.6rem;
      align-items:center;
      flex-wrap:wrap;
    }
    .social-link {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:0.5rem;
      padding:0.45rem 0.6rem;
      border-radius:10px;
      background: var(--surface);
      color: var(--text);
      text-decoration:none;
      border: 1px solid rgba(255,255,255,0.04);
      transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
      font-size:0.95rem;
    }
    .social-link .fa {
      color: var(--brand);
      font-size: 18px;
      line-height: 1;
    }
    .social-link:hover, .social-link:focus {
      transform: translateY(-3px);
      box-shadow: var(--shadow-brand);
      background: linear-gradient(90deg, var(--brand), var(--brand-hover));
      color: #fff;
    }
    .social-link:hover .fa, .social-link:focus .fa {
      color: #fff;
    }

    /* small helper for screen-reader-only text */
    .sr-only {
      position: absolute !important;
      height: 1px; width: 1px;
      overflow: hidden; clip: rect(1px, 1px, 1px, 1px);
      white-space: nowrap; border: 0; padding: 0; margin: -1px;
    }

    /* Map embed */
    .map-embed {
      display:flex;
      justify-content:center;
      margin-top: 1rem;
    }
    .map-embed iframe {
      width: 100%;
      max-width: 720px;
      height: 600px;
      border: 0;
      border-radius: 10px;
      box-shadow: 0 12px 36px rgba(0,0,0,0.55);
    }
    @media (max-width: 760px) {
      .map-embed iframe { height: 420px; }
    }

    /* Footer */
    .site-footer { padding: 1.25rem 0; margin-top: 2.5rem; text-align:center; }
    .footer-links { display:inline-flex; gap:0.5rem; align-items:center; justify-content:center; flex-wrap:wrap; padding:0; margin:0 0 0.6rem 0; list-style:none; }
    .footer-links a { color: #FFFFFF; text-decoration:none; padding: 0.25rem 0.6rem; }
    .footer-links a:hover { color: var(--text); transform: translateY(-4px); }
    .footer-copyright { color: var(--text-muted); font-size: 0. nine em; margin:0; }
  </style>
</head>
<body>
  <!-- Top navigation -->
  <nav class="top-nav" aria-label="Main navigation">
    <a href="ai.html" class="brand">🚀 AM-Global™</a>
    <div class="nav-links" role="menubar" aria-label="Primary links">
      <a href="research.html" role="menuitem">Research</a>
      <a href="projects.html" role="menuitem">Projects</a>
      <a href="contact.html" role="menuitem" aria-current="page">Contact</a>
      <a href="/blogs" role="menuitem" target="_blank" rel="noopener noreferrer">Blogs</a>
    </div>
  </nav>

  <h1 class="page-title">Contact</h1>
  <div class="page-subtitle"><h4>Contact Alfred Anate Bodurin Mayaki — enquiries, collaborations and community requests</h4></div>

  <main class="container" role="main" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="section-title" style="color:var(--text);margin:0 0 0.8rem 0;">Get in touch</h2>

    <div class="grid">
      <div class="contact-info" aria-labelledby="contact-details-heading">
        <h3 id="contact-details-heading">Contact details</h3>
        <p class="note">Visitors may contact Alfred using the details below for research enquiries, community collaborations, or facilitation requests.</p>

        <p><strong>Email:</strong><br><a href="mailto:alfred.mayaki@ou.ac.uk" style="color:var(--brand);text-decoration:none;">alfred.mayaki@ou.ac.uk</a></p>

        <div class="soft-separator" aria-hidden="true"></div>

        <p class="note"><strong>Expected reply time:</strong> Alfred aims to respond to enquiries within 3–5 working days. For urgent community support requests, please use the appropriate local support channels (see BipolarUK and Meetup pages).</p>

        <!-- Social icons + links (Font Awesome) -->
        <div class="social-links" role="navigation" aria-label="Social profiles">
          <a class="social-link" href="https://www.linkedin.com/in/alfredmayaki" target="_blank" rel="noopener noreferrer" aria-label="Alfred on LinkedIn">
            <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
            <span class="sr-only">LinkedIn</span>
          </a>

          <a class="social-link" href="https://x.com/alfredmayaki" target="_blank" rel="noopener noreferrer" aria-label="Alfred on X (formerly Twitter)">
            <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
            <span class="sr-only">X</span>
          </a>

          <a class="social-link" href="https://www.instagram.com/alfred.mayaki" target="_blank" rel="noopener noreferrer" aria-label="Alfred on Instagram">
            <i class="fa-brands fa-instagram" aria-hidden="true"></i>
            <span class="sr-only">Instagram</span>
          </a>

          <!-- Discord FA icon added beside other social icons -->
          <a class="social-link" href="https://discord.gg/QZDb56gguX" target="_blank" rel="noopener noreferrer" aria-label="Join our Discord">
            <i class="fa-brands fa-discord" aria-hidden="true"></i>
            <span class="sr-only">Discord</span>
          </a>
          <!-- GitHub icon linking to Alfred's profile -->
          <a class="social-link" href="https://github.com/alfredmayaki" target="_blank" rel="noopener noreferrer" aria-label="Alfred on GitHub">
            <i class="fa-brands fa-github" aria-hidden="true"></i>
            <span class="sr-only">GitHub</span>
          </a>
        </div>

      </div>

      <form id="contactForm" class="contact-form" aria-describedby="contact-form-desc" novalidate>
        <div id="contact-form-desc" class="note">Please provide your name, a contact email, and a short message. Submitted messages are sent to alfred.mayaki@ou.ac.uk. A confirmation will be shown after sending.</div>

        <label for="name">Your name <span class="note" aria-hidden="true">*</span></label>
        <input id="name" name="name" class="input" type="text" autocomplete="name" required />

        <label for="email">Your email <span class="note" aria-hidden="true">*</span></label>
        <input id="email" name="email" class="input" type="email" autocomplete="email" required />

        <label for="subject">Subject</label>
        <input id="subject" name="subject" class="input" type="text" />

        <label for="message">Message <span class="note" aria-hidden="true">*</span></label>
        <textarea id="message" name="message" required></textarea>

        <div class="actions" role="group" aria-label="Form actions">
          <button type="submit" id="sendBtn" class="btn">Send message</button>
          <button type="button" id="resetBtn" class="btn secondary">Reset</button>
          <div id="formStatus" style="margin-left:auto;color:var(--text-secondary);font-size:0.95rem;" aria-live="polite"></div>
        </div>

        <div id="errorList" style="color:#ffb3b3;font-size:0.95rem;"></div>
      </form>
    </div>

    <!-- Map: ArcGIS instant app embedded using provided iframe. Centered and responsive. -->
    <section aria-labelledby="map-heading" class="map-embed" style="margin-top:1.25rem;">
      <h2 id="map-heading" class="section-title" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;">Location map</h2>
      <iframe
        title="ArcGIS map — Alfred's constituency area of Peckham"
        src="https://www.arcgis.com/apps/instant/sidebar/index.html?appid=b5b0715207c245b3865a084f3f3ee7ec"
        width="400"
        height="600"
        frameborder="0"
        style="border:0"
        allowfullscreen>
        iFrames are not supported on this page.
      </iframe>
    </section>

    <p style="margin-top:1rem;color:var(--text-secondary);">By sending a message the visitor consents to the processing of all contact information for the purpose of responding to the enquiry. Personal data will be handled in accordance with the site's privacy policy.</p>
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="footer-content">
      <nav class="footer-links" aria-label="Footer links">
        <a href="#" id="cookieSettingsLink">Cookie Settings</a>
        <a href="privacy-policy.html">Privacy Policy</a>
        <a href="terms-of-use.html">Terms of Use</a>
        <a href="buymeacoffee.html">Buy Me a Coffee ☕</a>
      </nav>
      <p class="footer-copyright">
        © 2026 Alfred Anate Bodurin Mayaki. All rights reserved.
      </p>
    </div>
  </footer>

  <script>
    // Basic form reset handler and simple client-side validation placeholders.
    document.getElementById('resetBtn')?.addEventListener('click', function () {
      document.getElementById('contactForm')?.reset();
      document.getElementById('formStatus').textContent = '';
      document.getElementById('errorList').textContent = '';
    });

    // Cookie settings link behaviour (matches index implementation)
    document.getElementById('cookieSettingsLink')?.addEventListener('click', function (e) {
      e.preventDefault();
      document.cookie = 'cookie_consent=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      location.reload();
    });
  </script>
</body>
</html>