            <option value="https://orcid.org/0009-0006-3363-9603">🆔 Profilo Ricerca ORCID</option>
            <option value="https://learn1.open.ac.uk/mod/oublog/view.php?u=zt476627">✍️ Il mio Blog Open University</option>
            <option value="https://www.qeios.com/profile/102543">💻 Profilo di Ricerca Qeios</option>
                        <option value="https://openreview.net/profile?id=~Alfred_Anate_Bodurin_Mayaki1">📄 Profilo di Ricerca OpenReview</option>
          </select>
        </div>

        <p class="section-label">contatto</p>

        <div class="contact-info">
          <p><i class="fas fa-map-marker-alt"></i> Londra, Inghilterra (Regno Unito)</p>
          <p><i class="fas fa-envelope"></i> <a href="mailto:alfred.mayaki@ou.ac.uk">alfred.mayaki@ou.ac.uk</a></p>
          <p><i class="fas fa-phone"></i> <a href="tel:+447940916731">+44 7940 916 731</a></p>
