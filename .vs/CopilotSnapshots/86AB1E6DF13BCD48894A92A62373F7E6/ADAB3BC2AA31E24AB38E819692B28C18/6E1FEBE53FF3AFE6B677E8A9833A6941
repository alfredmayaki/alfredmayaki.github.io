    body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse at 20% 20%,rgba(124,58,237,.10) 0%,transparent 50%),radial-gradient(ellipse at 80% 80%,rgba(86,156,214,.08) 0%,transparent 50%),radial-gradient(ellipse at 50% 50%,rgba(78,201,176,.05) 0%,transparent 60%);z-index:-2;animation:gShift 15s ease-in-out infinite alternate}@keyframes gShift{0%{transform:scale(1) rotate(0)}100%{transform:scale(1.1) rotate(3deg)}}
