    .af{margin-top:auto;padding-top:1rem;border-top:1px solid var(--border-color);font-family:'JetBrains Mono',monospace;font-size:.6rem;color:var(--text-secondary);text-align:center}.af p{margin:.4rem 0}.af a{color:var(--js-blue);text-decoration:none;transition:color .2s}.af a:hover{color:var(--ai-accent)}.hi{width:134px;height:5px;background:var(--text-secondary);border-radius:3px;margin:12px auto 8px;opacity:.5}
