    :root{--js-green:#4ec9b0;--js-blue:#569cd6;--js-purple:#c586c0;--js-cyan:#9cdcfe;--js-string:#ce9178;--bg-dark:#0d1117;--bg-card:#161b22;--bg-elevated:#21262d;--border-color:#30363d;--text-primary:#e6edf3;--text-secondary:#8b949e;--ai-accent:#7c3aed;--ai-glow:rgba(124,58,237,0.35)}
