    .tagline{font-family:'JetBrains Mono',monospace;font-size:.65rem;color:var(--js-string);margin:.2rem 0;opacity:.9;text-align:center}.tagline::before{content:'// ';color:var(--js-green)}
    .ai-badge{display:inline-flex;align-items:center;gap:6px;margin:.75rem auto;padding:6px 14px;background:linear-gradient(135deg,rgba(124,58,237,.2),rgba(86,156,214,.15));border:1px solid rgba(124,58,237,.35);border-radius:20px;font-family:'JetBrains Mono',monospace;font-size:.6rem;color:var(--text-primary);letter-spacing:.5px;animation:badgePulse 3s ease-in-out infinite}.ai-badge .dot{width:6px;height:6px;background:var(--js-green);border-radius:50%;animation:pulse 2s infinite}@keyframes badgePulse{0%,100%{box-shadow:0 0 12px rgba(124,58,237,.15)}50%{box-shadow:0 0 24px rgba(124,58,237,.3)}}
