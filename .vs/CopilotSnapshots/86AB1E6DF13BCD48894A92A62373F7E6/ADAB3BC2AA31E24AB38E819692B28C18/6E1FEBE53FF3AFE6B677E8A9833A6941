    @media(max-width:480px){body{padding:.5rem}.phone-frame{border-radius:0;padding:0;box-shadow:none;max-width:100%}.phone-screen{border-radius:0}.dynamic-island{width:100px;height:28px;top:8px}.app-content{padding:45px 16px 20px;min-height:auto}}@media(min-width:768px){.phone-frame{max-width:440px}}@media(hover:none)and(pointer:coarse){.lb:active{transform:scale(.98);transition:transform .1s}}
