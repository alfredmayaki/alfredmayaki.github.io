  <style>
    :root{--js-yellow:#f7df1e;--js-orange:#ff9800;--js-green:#4ec9b0;--js-blue:#569cd6;--js-purple:#c586c0;--js-red:#f44747;--js-cyan:#9cdcfe;--js-string:#ce9178;--bg-dark:#0d1117;--bg-card:#161b22;--bg-elevated:#21262d;--border-color:#30363d;--text-primary:#e6edf3;--text-secondary:#8b949e;--glass-bg:rgba(22,27,34,0.85);--glass-border:rgba(255,255,255,0.1)}*{box-sizing:border-box}body{font-family:'Noto Sans Arabic','Inter','Segoe UI',sans-serif;background:var(--bg-dark);color:var(--text-primary);margin:0;padding:1rem;display:flex;align-items:center;justify-content:center;min-height:100vh;overflow-x:hidden}body::before{content:'';position:fixed;top:0;left:0;right:0;bottom:0;background:radial-gradient(ellipse at 20% 20%,rgba(247,223,30,0.08) 0%,transparent 50%),radial-gradient(ellipse at 80% 80%,rgba(86,156,214,0.08) 0%,transparent 50%),radial-gradient(ellipse at 50% 50%,rgba(197,134,192,0.05) 0%,transparent 60%);z-index:-2;animation:gradientShift 15s ease-in-out infinite alternate}@keyframes gradientShift{0%{transform:scale(1) rotate(0deg)}100%{transform:scale(1.1) rotate(3deg)}}.phone-frame{position:relative;width:100%;max-width:420px;background:linear-gradient(145deg,#1a1a1a 0%,#0a0a0a 100%);border-radius:45px;padding:12px;box-shadow:0 0 0 2px #2a2a2a,0 25px 50px -12px rgba(0,0,0,0.8),0 0 100px rgba(247,223,30,0.1),inset 0 1px 0 rgba(255,255,255,0.1);animation:phoneFloat 6s ease-in-out infinite}@keyframes phoneFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}.phone-screen{background:var(--bg-card);border-radius:35px;overflow:hidden;position:relative}.dynamic-island{position:absolute;top:12px;left:50%;transform:translateX(-50%);width:120px;height:32px;background:#000;border-radius:20px;z-index:100;display:flex;align-items:center;justify-content:center;gap:8px;transition:all 0.3s cubic-bezier(0.4,0,0.2,1);cursor:pointer}.dynamic-island:hover{width:160px;background:linear-gradient(90deg,#000 0%,#1a1a1a 100%)}.dynamic-island .camera{width:10px;height:10px;background:radial-gradient(circle,#1a3a5c 0%,#0a1a2c 100%);border-radius:50%;border:2px solid #2a2a2a}.dynamic-island .indicator{width:6px;height:6px;background:var(--js-green);border-radius:50%;animation:pulse 2s infinite}@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.5;transform:scale(0.8)}}.status-bar{display:flex;justify-content:space-between;align-items:center;padding:14px 24px 8px;font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:600;color:var(--text-primary);direction:ltr}.status-bar .time{color:var(--js-yellow)}.status-bar .icons{display:flex;gap:6px;align-items:center}.status-bar .icons span{font-size:14px}.battery{display:flex;align-items:center;gap:2px}.battery-body{width:22px;height:10px;border:1.5px solid var(--js-green);border-radius:3px;padding:1px}.battery-level{height:100%;width:80%;background:var(--js-green);border-radius:1px}.battery-tip{width:2px;height:5px;background:var(--js-green);border-radius:0 1px 1px 0}.profile-container{text-align:center;padding:50px 20px 24px;min-height:600px;display:flex;flex-direction:column;background:linear-gradient(180deg,var(--bg-card) 0%,var(--bg-dark) 100%)}.code-comment{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--js-green);opacity:0.7;margin-bottom:4px;letter-spacing:0.5px;direction:ltr}.profile-photo{width:100px;height:100px;border-radius:24px;border:3px solid var(--js-yellow);margin:0 auto 1rem;object-fit:cover;box-shadow:0 0 20px rgba(247,223,30,0.3),0 8px 32px rgba(0,0,0,0.4);transition:transform 0.3s ease,box-shadow 0.3s ease}.profile-photo:hover{transform:scale(1.05) rotate(-2deg);box-shadow:0 0 30px rgba(247,223,30,0.5),0 12px 40px rgba(0,0,0,0.5)}h1{font-family:'JetBrains Mono',monospace;color:var(--text-primary);font-size:1.1rem;font-weight:700;margin:0 0 0.5rem 0;line-height:1.3;direction:ltr}h1 .keyword{color:var(--js-purple)}h1 .function{color:var(--js-yellow)}h1 .bracket{color:var(--js-cyan)}.verified-badge{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;background:var(--js-blue);border-radius:50%;margin-right:6px;vertical-align:middle;font-size:10px;color:#fff}.tagline{font-family:'Noto Sans Arabic','JetBrains Mono',monospace;font-size:0.7rem;color:var(--js-string);margin:0.3rem 0;opacity:0.9}.tagline::after{content:' //';color:var(--js-green)}.section-label{font-family:'JetBrains Mono',monospace;font-size:0.65rem;color:var(--js-blue);margin:1.5rem 0 0.75rem;text-transform:uppercase;letter-spacing:1px;direction:ltr}.section-label::before{content:'const ';color:var(--js-purple)}.section-label::after{content:' = [';color:var(--js-cyan)}.links-grid{display:flex;flex-direction:column;gap:8px;padding:0 12px;margin:0 auto;width:100%;max-width:320px}.link-btn{display:flex;align-items:center;gap:10px;background:var(--bg-elevated);border:1px solid var(--border-color);border-radius:12px;color:var(--text-primary);text-decoration:none;font-family:'Noto Sans Arabic','Inter',sans-serif;font-size:0.75rem;font-weight:500;padding:12px 16px;transition:all 0.2s cubic-bezier(0.4,0,0.2,1);cursor:pointer;position:relative;overflow:hidden;flex-direction:row-reverse}.link-btn::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(135deg,var(--js-yellow) 0%,var(--js-orange) 100%);opacity:0;transition:opacity 0.2s ease;border-radius:11px}.link-btn:hover::before{opacity:1}.link-btn:hover{transform:translateX(-4px);border-color:var(--js-yellow);box-shadow:0 4px 12px rgba(247,223,30,0.2)}.link-btn:hover span{color:#000}.link-btn i,.link-btn .icon{font-size:1rem;color:var(--js-cyan);position:relative;z-index:1;width:20px;text-align:center}.link-btn span{position:relative;z-index:1;transition:color 0.2s ease}.grid-close{font-family:'JetBrains Mono',monospace;font-size:0.65rem;color:var(--js-cyan);margin-top:0.75rem;direction:ltr}.contact-section{margin-top:1.5rem;padding:0 12px}.contact-item{display:flex;align-items:center;gap:8px;font-family:'JetBrains Mono',monospace;font-size:0.65rem;color:var(--text-secondary);margin:0.5rem 0;justify-content:center;flex-direction:row-reverse}.contact-item i{color:var(--js-cyan);width:16px}.contact-item a{color:var(--js-blue);text-decoration:none}.contact-item a:hover{color:var(--js-yellow)}.terminal-prompt{font-family:'JetBrains Mono',monospace;font-size:0.6rem;color:var(--text-secondary);margin-top:1rem;direction:ltr}.terminal-prompt::before{content:'$ ';color:var(--js-green)}.cursor{display:inline-block;width:8px;height:14px;background:var(--js-yellow);margin-left:2px;animation:blink 1s step-end infinite;vertical-align:middle}@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}.app-footer{margin-top:auto;padding-top:1rem;border-top:1px solid var(--border-color);font-family:'Noto Sans Arabic','JetBrains Mono',monospace;font-size:0.6rem;color:var(--text-secondary)}.app-footer p{margin:0.4rem 0}.app-footer a{color:var(--js-blue);text-decoration:none;transition:color 0.2s ease}.app-footer a:hover{color:var(--js-yellow)}.home-indicator{width:134px;height:5px;background:var(--text-secondary);border-radius:3px;margin:12px auto 8px;opacity:0.5}@media (max-width:480px){body{padding:0.5rem}.phone-frame{border-radius:0;padding:0;box-shadow:none;max-width:100%}.phone-screen{border-radius:0}.dynamic-island{width:100px;height:28px;top:8px}.profile-container{padding:45px 16px 20px;min-height:auto}}@media (min-width:768px){.phone-frame{max-width:440px}}@keyframes fadeIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}.phone-frame{animation:fadeIn 0.6s ease-out,phoneFloat 6s ease-in-out 0.6s infinite}@media (hover:none) and (pointer:coarse){.link-btn:active{transform:scale(0.98);transition:transform 0.1s ease}}
  </style>
</head>
