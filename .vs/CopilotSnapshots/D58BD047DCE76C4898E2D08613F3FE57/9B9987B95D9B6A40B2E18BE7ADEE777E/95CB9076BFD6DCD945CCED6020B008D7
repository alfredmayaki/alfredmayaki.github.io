      margin-bottom: 2rem;
      border: 1px solid rgba(37,99,235,0.2);
    }

    .hero-emoji {
      font-size: 4rem;
      margin-bottom: 1rem;
      display: block;
      animation: bounce 2s ease-in-out infinite;
    }

    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    .hero h1 {
      font-family: 'JetBrains Mono', monospace;
      font-size: 2rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.5rem;
    }

    .hero .date {
      font-size: 1.2rem;
      color: var(--library-amber);
      font-weight: 600;
      margin-bottom: 1rem;
    }

    .hero p {
      color: var(--text-secondary);
      max-width: 600px;
      margin: 0 auto;
      font-size: 1.05rem;
    }

    /* Section Styling */
    .section {
      margin-bottom: 2.5rem;
    }

    .section h2 {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.3rem;
      color: var(--library-amber);
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .section h2::before {
      content: '//';
      color: var(--text-muted);
      font-weight: 400;
    }

    /* Fact Cards */
    .fact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
    }

    .fact-card {
      background: var(--bg-elevated);
