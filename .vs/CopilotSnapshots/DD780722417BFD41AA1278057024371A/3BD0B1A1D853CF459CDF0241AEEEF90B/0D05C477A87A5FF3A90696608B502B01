<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Neurodiversity in Recruitment — Survey</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Secure survey on neurodiversity in recruitment. Research study based on Miller and Doyle (2025).">
  <meta name="author" content="Alfred Anate Bodurin Mayaki">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">

  <!-- Environment Variable Loader (Development) -->
  <script src="env-loader.js"></script>

  <!-- Google Auth Library -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>

  <style>
    :root {
      --font-sans: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
      --bg: #0f0f0f;
      --bg-overlay: rgba(22, 22, 22, 0.92);
      --panel: #161616;
      --panel-2: #141414;
      --surface: #2a2a2a;
      --text: #ffffff;
      --text-muted: #979797;
      --text-secondary: #b0b0b0;
      --border: #464242;
      --border-soft: rgba(255, 255, 255, 0.06);
      --brand: #3d4ee9;
      --brand-hover: #5563f0;
      --green: #10b981;
      --amber: #f59e0b;
      --red: #ef4444;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html {
      background: url("/universe.png") center / cover no-repeat fixed;
      background-color: var(--bg);
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-sans);
      color: var(--text-muted);
      background: transparent;
      min-height: 100vh;
      padding: 1em;
    }

    /* ============ HEADER ============ */
    .header {
      max-width: 900px;
      margin: 0 auto 2em;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.6rem 1.2rem;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s;
      font-size: 0.9rem;
      font-weight: 500;
      white-space: nowrap;
    }

    .back-btn:hover {
      background: var(--brand);
      border-color: var(--brand);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(61, 78, 233, 0.4);
    }

    .header-title {
      flex: 1;
      min-width: 200px;
    }

    .header-title h1 {
      font-size: 2em;
      color: var(--text);
      margin-bottom: 0.5rem;
    }

    .header-subtitle {
      font-size: 0.95rem;
      color: var(--text-secondary);
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 1rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.9rem;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      object-fit: cover;
    }

    .logout-btn {
      padding: 0.6rem 1.2rem;
      background: var(--red);
      color: white;
      border: 1px solid var(--red);
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 500;
      transition: all 0.2s;
    }

    .logout-btn:hover {
      background: #dc2626;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
    }

    /* ============ MAIN CONTAINER ============ */
    .container {
      max-width: 900px;
      margin: 0 auto;
      background: var(--bg-overlay);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2rem;
    }

    /* ============ LOGIN SECTION ============ */
    .login-section {
      text-align: center;
      padding: 3rem 2rem;
    }

    .login-info {
      margin-bottom: 2rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .login-info p {
      margin: 0.5rem 0;
    }

    #google-login-btn {
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 2rem auto;
    }

    /* Ensure Google button wrapper is centered */
    #google-login-btn > div {
      display: flex;
      justify-content: center;
    }

    /* ============ FORM SECTION ============ */
    .form-section {
      display: none;
    }

    .form-section.active {
      display: block;
    }

    .info-banner {
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid var(--green);
      border-radius: 8px;
      padding: 1rem;
      margin-bottom: 2rem;
      color: var(--text-secondary);
      font-size: 0.9rem;
    }

    .info-banner strong {
      color: var(--green);
    }

    /* ============ QUESTION ============ */
    .question-group {
      margin-bottom: 2.5rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.5rem;
      transition: all 0.3s;
    }

    .question-group:hover {
      border-color: var(--brand);
      background: var(--panel);
    }

    .question-number {
      display: inline-block;
      background: var(--brand);
      color: white;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 0.9rem;
      margin-bottom: 1rem;
    }

    .question-label {
      display: block;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.75rem;
      font-size: 1rem;
      line-height: 1.5;
    }

    .question-required {
      color: var(--red);
      margin-left: 0.25rem;
    }

    .sub-questions {
      margin-top: 1.5rem;
      padding-left: 2rem;
      border-left: 2px solid var(--border);
    }

    .sub-question {
      margin-bottom: 1rem;
    }

    .sub-question-label {
      display: block;
      font-size: 0.95rem;
      color: var(--text-secondary);
      margin-bottom: 0.5rem;
      font-weight: 500;
    }

    textarea {
      width: 100%;
      padding: 0.5rem;
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 6px;
      font-family: var(--font-sans);
      font-size: 0.95rem;
      resize: vertical;
      transition: all 0.2s;
    }

    textarea:focus {
      outline: none;
      border-color: var(--brand);
      box-shadow: 0 0 0 3px rgba(61, 78, 233, 0.2);
      background: var(--surface);
    }

    textarea::placeholder {
      color: var(--text-secondary);
      opacity: 0.9;
    }

    /* Size variations */
    .textarea-sm { height: 80px; }
    .textarea-md { height: 120px; }
    .textarea-lg { height: 160px; }

    /* ============ BUTTONS ============ */
    .button-group {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-primary {
      background: var(--brand);
      color: white;
    }

    .btn-primary:hover {
      background: var(--brand-hover);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(61, 78, 233, 0.4);
    }

    .btn-secondary {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background: var(--panel);
      border-color: var(--brand);
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    /* ============ STATUS MESSAGES ============ */
    .status-message {
      padding: 1rem;
      border-radius: 8px;
      margin: 1rem 0;
      font-size: 0.95rem;
      animation: slideIn 0.3s ease-out;
    }

    @keyframes slideIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .status-success {
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid var(--green);
      color: var(--green);
    }

    .status-error {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid var(--red);
      color: var(--red);
    }

    .status-loading {
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid var(--amber);
      color: var(--amber);
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .spinner {
      width: 20px;
      height: 20px;
      border: 2px solid rgba(245, 158, 11, 0.3);
      border-top-color: var(--amber);
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* ============ SUCCESS PAGE ============ */
    .success-page {
      display: none;
      text-align: center;
      padding: 3rem 2rem;
    }

    .success-page.active {
      display: block;
    }

    .success-icon {
      font-size: 4rem;
      margin-bottom: 1rem;
      color: var(--green);
    }

    .success-message h2 {
      font-size: 1.5rem;
      color: var(--text);
      margin-bottom: 0.5rem;
    }

    .success-message p {
      color: var(--text-secondary);
      margin-bottom: 2rem;
      line-height: 1.6;
    }

    /* ============ ERROR PAGE ============ */
    .error-page {
      display: none;
      padding: 2rem;
    }

    .error-page.active {
      display: block;
    }

    .error-content {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid var(--red);
      border-radius: 8px;
      padding: 2rem;
      text-align: center;
    }

    .error-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
      color: var(--red);
    }

    .error-content h2 {
      color: var(--red);
      margin-bottom: 1rem;
    }

    .error-content p {
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
    }

    /* ============ PROGRESS BAR ============ */
    .progress-section {
      margin-bottom: 2rem;
    }

    .progress-label {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.5rem;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .progress-bar {
      width: 100%;
      height: 6px;
      background: var(--panel);
      border-radius: 3px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: var(--brand);
      width: 0%;
      transition: width 0.3s ease;
    }

    /* ============ FOOTER ============ */
    .footer {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
      text-align: center;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .footer p {
      margin: 0.25rem 0;
    }

    .footer-link {
      color: var(--brand);
      text-decoration: none;
      transition: color 0.2s;
    }

    .footer-link:hover {
      color: var(--brand-hover);
      text-decoration: underline;
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 768px) {
      .container { padding: 1.5rem; }
      .header { flex-direction: column; align-items: flex-start; }
      .header-title h1 { font-size: 1.5rem; }
      .header-right { width: 100%; }
      .user-info { flex: 1; }
      .logout-btn { flex: 1; }
    }

    @media (max-width: 480px) {
      body { padding: 0.5em; }
      .container { padding: 1rem; }
      .question-group { padding: 1rem; }
      .button-group { flex-direction: column; }
      .btn { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>
  <!-- Header -->
  <div class="header">
    <a href="index.html" class="back-btn">
      <i class="fas fa-arrow-left"></i>
      Back to Home
    </a>
    <div class="header-title">
      <h1>🧠 Neurodiversity in Recruitment</h1>
      <span class="header-subtitle">Research Survey — Secure & Confidential</span>
    </div>
    <div class="header-right" id="userSection" style="display: none;">
      <div class="user-info">
        <img id="userAvatar" class="user-avatar" alt="User avatar">
        <span id="userName"></span>
      </div>
      <button class="logout-btn" id="logoutBtn">Logout</button>
    </div>
  </div>

  <!-- Main Container -->
  <div class="container">
    <!-- Login Section -->
    <div class="login-section" id="loginSection">
      <h2 style="color: var(--text); margin-bottom: 1rem;">Sign in to Continue</h2>
      <div class="login-info">
        <p>This is a secure research survey on neurodiversity in recruitment.</p>
        <p>You can only complete this survey once per Google Account.</p>
        <p>Your responses will be stored securely and used for research purposes only.</p>
        <p style="margin-top: 1.5rem; font-size: 0.85rem;">
          <strong>Based on:</strong> Miller & Doyle (2025) - Signalling a diversity climate: Neurodivergent experiences and perceptions during selection and assessment
        </p>
        <p style="margin-top: 1rem; font-size: 0.8rem; color: var(--text-muted);">
          By signing in, you agree to our <a href="privacy-policy.html" style="color: var(--brand);">Privacy Policy</a> and 
          consent to participate in this research study. Your data will be processed securely and kept confidential.
        </p>
      </div>
      <div style="display: flex; flex-direction: column; gap: 1rem; align-items: center;">
        <div id="google-login-btn"></div>
        <button id="linkedin-login-btn" type="button" style="display: flex; align-items: center; gap: 0.5rem; background: #0077b5; color: #fff; border: none; border-radius: 6px; padding: 0.75rem 1.5rem; font-size: 1rem; font-weight: 600; cursor: pointer;">
          <img src="https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/linkedin.svg" alt="LinkedIn" style="width: 22px; height: 22px; filter: brightness(0) invert(1);">
          Sign in with LinkedIn
        </button>
      </div>
      <p style="margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-secondary);">
        Don't have a Google Account? Visit <a href="https://gmail.com" target="_blank" rel="noopener noreferrer" style="color: var(--brand); text-decoration: none;">gmail.com</a> to create one.
      </p>
    </div>

    <!-- Survey Form Section -->
    <div class="form-section" id="formSection">
      <div class="info-banner">
        <strong>ℹ️ Survey Instructions:</strong> Please answer all questions honestly. Your responses are confidential and will only be used for research. This survey takes approximately 10-15 minutes.
      </div>

      <div class="progress-section">
        <div class="progress-label">
          <span>Progress</span>
          <span><span id="currentQuestion">1</span>/7</span>
        </div>
        <div class="progress-bar">
          <div class="progress-fill" id="progressFill"></div>
        </div>
      </div>

      <form id="surveyForm">
        <!-- Q1: What attracts you to an organization? -->
        <div class="question-group">
          <div class="question-number">1</div>
          <label class="question-label">
            What attracts you to an organization?
            <span class="question-required">*</span>
          </label>
          <textarea 
            name="q1" 
            class="textarea-md" 
            placeholder="Share what factors or qualities make an organization attractive to you as a potential employer. Consider values, work environment, benefits, culture, or other factors."
            required>
          </textarea>
        </div>

        <!-- Q2: How do you perceive if a potential employer is inclusive during recruitment? -->
        <div class="question-group">
          <div class="question-number">2</div>
          <label class="question-label">
            How do you perceive if a potential employer is inclusive during recruitment?
            <span class="question-required">*</span>
          </label>
          <textarea 
            name="q2" 
            class="textarea-md" 
            placeholder="Describe the signs, behaviors, or practices that make you feel a potential employer is genuinely inclusive and welcoming to diverse candidates."
            required>
          </textarea>
          
          <div class="sub-questions">
            <div class="sub-question">
              <label class="sub-question-label">a. How does this impact you?</label>
              <textarea 
                name="q2a" 
                class="textarea-sm" 
                placeholder="Explain how your perception of employer inclusivity affects your decision to apply or engage with an organization.">
              </textarea>
            </div>
          </div>
        </div>

        <!-- Q3: What was your experience of applying to your current organization? -->
        <div class="question-group">
          <div class="question-number">3</div>
          <label class="question-label">
            What was your experience of applying to your current organization?
            <span class="question-required">*</span>
          </label>
          <textarea 
            name="q3" 
            class="textarea-md" 
            placeholder="Describe your experience of the application and recruitment process, including the job search, application submission, interviews, and hiring decisions."
            required>
          </textarea>

          <div class="sub-questions">
            <div class="sub-question">
              <label class="sub-question-label">a. Do you have other experiences that have been the same, or different?</label>
              <textarea 
                name="q3a" 
                class="textarea-sm" 
                placeholder="Share other recruitment experiences from different organizations to compare and contrast.">
              </textarea>
            </div>
          </div>
        </div>

        <!-- Q4: Do you disclose your neurodivergence during recruitment? -->
        <div class="question-group">
          <div class="question-number">4</div>
          <label class="question-label">
            Do you disclose your neurodivergence during recruitment?
            <span class="question-required">*</span>
          </label>
          <textarea 
            name="q4" 
            class="textarea-md" 
            placeholder="Explain your approach to disclosing (or not disclosing) your neurodivergence during the recruitment process, and your reasons for this decision."
            required>
          </textarea>

          <div class="sub-questions">
            <div class="sub-question">
              <label class="sub-question-label">a. What has been your experience of disclosing or deciding not to disclose?</label>
              <textarea 
                name="q4a" 
                class="textarea-lg" 
                placeholder="Share detailed experiences of how disclosure (or non-disclosure) has affected your recruitment journey. Include positive outcomes, challenges, and any lessons learned.">
              </textarea>
            </div>
          </div>
        </div>

        <!-- Q5: What has been your experience of adjustments during recruitment? -->
        <div class="question-group">
          <div class="question-number">5</div>
          <label class="question-label">
            What has been your experience of adjustments during recruitment?
            <span class="question-required">*</span>
          </label>
          <textarea 
            name="q5" 
            class="textarea-lg" 
            placeholder="Describe any adjustments (formal or informal) you received during the recruitment process. Include whether you requested them, how effective they were, and their impact on your recruitment experience."
            required>
          </textarea>
        </div>

        <!-- Q6: When you have been at your best during recruitment, that's like what? -->
        <div class="question-group">
          <div class="question-number">6</div>
          <label class="question-label">
            When you have been at your best during recruitment, that's like what?
            <span class="question-required">*</span>
          </label>
          <textarea 
            name="q6" 
            class="textarea-md" 
            placeholder="Describe the conditions, environment, or support that enabled you to perform at your best during recruitment processes."
            required>
          </textarea>

          <div class="sub-questions">
            <div class="sub-question">
              <label class="sub-question-label">a. How did the organization help you do your best?</label>
              <textarea 
                name="q6a" 
                class="textarea-sm" 
                placeholder="Explain specific actions, attitudes, or practices by the organization that supported you.">
              </textarea>
            </div>
          </div>
        </div>

        <!-- Q7: Anything else you want to share? -->
        <div class="question-group">
          <div class="question-number">7</div>
          <label class="question-label">
            Anything else you want to share?
          </label>
          <textarea 
            name="q7" 
            class="textarea-md" 
            placeholder="Use this space to share any additional thoughts, experiences, or recommendations related to neurodiversity and recruitment. (Optional)">
          </textarea>
        </div>

        <div id="statusMessage"></div>

        <div class="button-group">
          <button type="submit" class="btn btn-primary">
            <span id="submitIcon">📤</span>
            <span id="submitText">Submit Survey</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Success Page -->
    <div class="success-page" id="successPage">
      <div class="success-icon">✅</div>
      <div class="success-message">
        <h2>Thank you for completing the survey!</h2>
        <p>Your responses have been recorded securely and will contribute to this important research on neurodiversity in recruitment.</p>
        <p style="font-size: 0.9rem; color: var(--text-muted);">
          <strong>Survey Reference:</strong> Miller & Doyle (2025)<br>
          Your submission was recorded at <span id="submissionTime"></span>
        </p>
      </div>
      <div class="button-group">
        <a href="index.html" class="btn btn-primary">
          Return to Homepage
        </a>
      </div>
    </div>

    <!-- Error Page -->
    <div class="error-page" id="errorPage">
      <div class="error-content">
        <div class="error-icon">⚠️</div>
        <h2>Unable to Complete Survey</h2>
        <p id="errorMessage"></p>
        <div class="button-group">
          <button class="btn btn-secondary" onclick="location.reload()">Try Again</button>
          <a href="index.html" class="btn btn-primary">Return Home</a>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <p>🔒 <strong>Privacy & Security:</strong> Your data is encrypted and securely stored. Read our <a href="privacy-policy.html" style="color: var(--brand);">Privacy Policy</a> • <a href="terms-of-use.html" style="color: var(--brand);">Terms of Use</a> • <a href="https://www.qeios.com/profile/102543" style="color: var(--brand);">💻 Qeios Research Profile</a></p>
      <p>📊 <strong>Based on:</strong> Miller, H., & Doyle, N. (2025). <em>Journal of Occupational and Organizational Psychology</em>, 98(3)</p>
      <p>© 2026 — Research to be conducted by Alfred Anate Bodurin Mayaki, Supervised by Dr. Nicola J. Bowman</p>
    </div>
  </div>

  <!-- Font Awesome for Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <script>
    // ===================================
    // SECURE CONFIGURATION MANAGER
    // ===================================
    // Loads environment variables safely without exposing credentials
    // Supports: .env.local (development) and process.env (build-time injection)

    class ConfigManager {
      constructor() {
        this.config = {};
        this.loadConfig();
        this.validateConfig();
      }

      /**
       * Load configuration from multiple sources
       * Priority: window.__ENV__ > import.meta.env > .env file
       */
      loadConfig() {
        // Check if running with build tool (Vite, Webpack, etc.)
        if (typeof window !== 'undefined' && window.__ENV__) {
          this.config = window.__ENV__;
          console.log('✅ Config loaded from window.__ENV__ (build-time injection)');
          return;
        }

        // For static HTML files, load from localStorage (populated by .env.local loader)
        if (typeof window !== 'undefined' && window.localStorage) {
          const envConfig = localStorage.getItem('__app_config__');
          if (envConfig) {
            try {
              this.config = JSON.parse(envConfig);
              console.log('✅ Config loaded from localStorage');
              return;
            } catch (e) {
              console.warn('⚠️ Failed to parse localStorage config');
            }
          }
        }

        // Fallback: Try to load from global config (for manual setup)
        if (typeof window !== 'undefined' && window.__APP_CONFIG__) {
          this.config = window.__APP_CONFIG__;
          console.log('✅ Config loaded from window.__APP_CONFIG__');
          return;
        }

        console.warn('⚠️ No configuration found');
      }

      /**
       * Validate all required configuration values exist
       */
      validateConfig() {
        const required = [
          'FIREBASE_API_KEY',
          'FIREBASE_AUTH_DOMAIN',
          'FIREBASE_PROJECT_ID',
          'FIREBASE_STORAGE_BUCKET',
          'FIREBASE_MESSAGING_SENDER_ID',
          'FIREBASE_APP_ID',
          'BACKEND_URL'
        ];

        const missing = required.filter(key => !this.get(key));

        if (missing.length > 0) {
          console.error('❌ Missing required configuration:', missing);
          this.showConfigError(missing);
          throw new Error(`Missing configuration: ${missing.join(', ')}`);
        }

        console.log('✅ All required configuration validated');
      }

      /**
       * Get a configuration value safely
       */
      get(key) {
        const value = this.config[key];
        if (!value) {
          console.warn(`⚠️ Config key not found: ${key}`);
          return null;
        }
        return String(value);
      }

      /**
       * Get all configuration as object
       */
      getAll() {
        return { ...this.config };
      }

      /**
       * Get Firebase configuration object
       */
      getFirebaseConfig() {
        return {
          apiKey: this.get('FIREBASE_API_KEY'),
          authDomain: this.get('FIREBASE_AUTH_DOMAIN'),
          projectId: this.get('FIREBASE_PROJECT_ID'),
          storageBucket: this.get('FIREBASE_STORAGE_BUCKET'),
          messagingSenderId: this.get('FIREBASE_MESSAGING_SENDER_ID'),
          appId: this.get('FIREBASE_APP_ID')
        };
      }

      /**
       * Get backend URL
       */
      getBackendUrl() {
        return this.get('BACKEND_URL');
      }

      /**
       * Show configuration error UI
       */
      showConfigError(missing) {
        const loginSection = document.getElementById('loginSection');
        if (!loginSection) return;

        const missingStr = missing.join(', ');
        loginSection.innerHTML = `
          <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; border-radius: 8px; padding: 2rem; text-align: center;">
            <h2 style="color: #ef4444; margin-bottom: 1rem;">⚠️ Configuration Error</h2>
            <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">
              This survey app is not properly configured. Missing: <code style="background: var(--surface); padding: 0.25rem 0.5rem; border-radius: 4px;">${missingStr}</code>
            </p>
            <div style="background: var(--surface); padding: 1.5rem; border-radius: 6px; text-align: left; margin-bottom: 1.5rem;">
              <p style="color: var(--text); margin-bottom: 1rem;"><strong>✅ Setup Instructions:</strong></p>
              <ol style="color: var(--text-secondary); line-height: 2; font-size: 0.9rem;">
                <li><strong>Create <code>.env.local</code> file</strong> in your project root (do NOT commit to git)</li>
                <li><strong>Copy values from <code>.env.example</code></strong></li>
                <li><strong>Fill in your Firebase credentials:</strong>
                  <ul style="margin-top: 0.5rem; margin-left: 1.5rem;">
                    <li>Go to <a href="https://console.firebase.google.com" target="_blank" style="color: var(--brand);">Firebase Console</a></li>
                    <li>Select your project</li>
                    <li>Click Settings ⚙️ > Project Settings</li>
                    <li>Copy Web App config values</li>
                  </ul>
                </li>
                <li><strong>Set your Backend URL</strong> (Cloud Functions endpoint)</li>
                <li><strong>Reload this page</strong> after updating .env.local</li>
              </ol>
            </div>
            <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid var(--green); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem;">
              <p style="color: var(--text-secondary); font-size: 0.85rem;"><strong style="color: var(--green);">💡 Development:</strong> For local development, ensure your build tool or a config loader script reads .env.local and injects variables.</p>
            </div>
            <button onclick="location.reload()" class="btn btn-primary" style="background: var(--brand); color: white; border: none;">
              Retry Configuration
            </button>
          </div>
        `;
      }
    }

    // ===================================
    // INITIALIZE CONFIG MANAGER
    // ===================================
    let configManager;
    try {
      configManager = new ConfigManager();
    } catch (error) {
      console.error('Configuration initialization failed:', error);
    }

    // ===================================
    // STATE MANAGEMENT
    // ===================================
    let currentUser = null;
    let hasSubmitted = false;
    let googleInitialized = false;

    // ===================================
    // OAUTH INITIALIZATION (GOOGLE & LINKEDIN)
    // ===================================
    function initializeOAuth() {
      // Google Sign-In
      if (typeof google !== 'undefined' && google.accounts) {
        try {
          google.accounts.id.initialize({
            client_id: configManager.get('GOOGLE_CLIENT_ID'),
            callback: handleGoogleSignIn,
            auto_select: false,
            itp_support: true
          });
          google.accounts.id.renderButton(
            document.getElementById('google-login-btn'),
            {
              type: 'standard',
              size: 'large',
              text: 'signin_with',
              shape: 'rounded',
              logo_alignment: 'left',
              width: '300'
            }
          );
          google.accounts.id.prompt((notification) => {
            if (notification.isNotDisplayed()) {
              console.log('One Tap UI not displayed');
            }
            if (notification.isSkippedMoment()) {
              console.log('One Tap skipped');
            }
          });
          googleInitialized = true;
          console.log('✅ Google OAuth 2.0 initialized successfully');
        } catch (error) {
          console.error('❌ Failed to initialize Google Sign-In:', error);
          showError('Failed to initialize Google Sign-In. Please refresh the page.');
        }
      }

      // LinkedIn Sign-In
      const linkedinBtn = document.getElementById('linkedin-login-btn');
      if (linkedinBtn && typeof firebase !== 'undefined' && firebase.auth) {
        linkedinBtn.addEventListener('click', async () => {
          try {
            const provider = new firebase.auth.OAuthProvider('linkedin.com');
            provider.addScope('r_liteprofile');
            provider.addScope('r_emailaddress');
            const result = await firebase.auth().signInWithPopup(provider);
            const user = result.user;
            currentUser = {
              id: user.uid,
              email: user.email,
              name: user.displayName || 'User',
              picture: user.photoURL || '',
              provider: 'linkedin',
              emailVerified: user.emailVerified
            };
            console.log('✅ LinkedIn user authenticated:', currentUser);
            await checkIfUserSubmitted(currentUser.id);
            displayUserInfo();
            showSurveyForm();
          } catch (error) {
            console.error('❌ LinkedIn Sign-In error:', error);
            showError('LinkedIn Sign-In failed. Please try again.');
          }
        });
      }
    }

    // ===================================
    // HANDLE GOOGLE SIGN-IN CALLBACK
    // ===================================
    async function handleGoogleSignIn(response) {
      if (!response.credential) {
        showError('Google Sign-In failed. Please try again.');
        return;
      }

      try {
        console.log('🔐 Google Sign-In successful. Processing token...');

        // Decode JWT token to extract user information
        const userPayload = parseJwt(response.credential);

        if (!userPayload) {
          throw new Error('Invalid token format');
        }

        // Store user information
        currentUser = {
          id: userPayload.sub,                    // Unique Google ID
          email: userPayload.email,               // Email address
          name: userPayload.name,                 // Full name
          picture: userPayload.picture,           // Profile picture URL
          emailVerified: userPayload.email_verified // Email verification status
        };

        console.log('✅ User authenticated:', {
          name: currentUser.name,
          email: currentUser.email
        });

        // Check if user has already submitted
        await checkIfUserSubmitted(currentUser.id);

        // Update UI to show logged-in state
        displayUserInfo();
        showSurveyForm();

      } catch (error) {
        console.error('❌ Error processing sign-in:', error);
        showError(`Sign-in error: ${error.message}`);
      }
    }

    // ===================================
    // JWT TOKEN DECODER
    // ===================================
    function parseJwt(token) {
      try {
        // JWT format: header.payload.signature
        const base64Url = token.split('.')[1];
        const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');

        // Decode base64
        const jsonPayload = decodeURIComponent(
          atob(base64).split('').map((c) => {
            return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
          }).join('')
        );

        return JSON.parse(jsonPayload);
      } catch (error) {
        console.error('❌ Failed to parse JWT:', error);
        return null;
      }
    }

    // ===================================
    // CHECK FOR DUPLICATE SUBMISSIONS
    // ===================================
    async function checkIfUserSubmitted(userId) {
      try {
        // Check backend to see if user already submitted
        const backendUrl = configManager.getBackendUrl();
        const response = await fetch(`${backendUrl}/checkSubmission`, {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ userId })
        });

        if (!response.ok) {
          console.warn('⚠️ Could not verify submission status');
          return;
        }

        const data = await response.json();

        if (data.hasSubmitted) {
          hasSubmitted = true;
          console.log('⚠️ User has already submitted survey');
          showError(
            'You have already completed this survey. Each Google account can only submit once. ' +
            'If you believe this is an error, please contact the researcher.'
          );
          throw new Error('Duplicate submission detected');
        }

        console.log('✅ User can submit survey');

      } catch (error) {
        if (error.message === 'Duplicate submission detected') {
          showErrorPage();
          throw error;
        }
        console.warn('⚠️ Submission check failed:', error.message);
        // Continue anyway - don't block user if backend is unavailable
      }
    }

    // ===================================
    // CONFIGURATION ERROR PAGE
    // ===================================
    function showConfigurationError() {
      document.getElementById('loginSection').innerHTML = `
        <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; border-radius: 8px; padding: 2rem; text-align: center;">
          <h2 style="color: #ef4444; margin-bottom: 1rem;">⚠️ Configuration Required</h2>
          <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">
            This survey app needs to be configured with your Google OAuth 2.0 credentials before it can be used.
          </p>
          <div style="background: var(--surface); padding: 1rem; border-radius: 6px; text-align: left; margin-bottom: 1.5rem;">
            <p style="color: var(--text); margin-bottom: 0.5rem;"><strong>Steps to configure:</strong></p>
            <ol style="color: var(--text-secondary); line-height: 1.8;">
              <li>Go to <a href="https://console.cloud.google.com/" target="_blank" style="color: var(--brand);">Google Cloud Console</a></li>
              <li>Create OAuth 2.0 Client ID</li>
              <li>Copy the Client ID</li>
              <li>In msc-survey.html, find the CONFIG object and replace:
                <div style="background: var(--panel); padding: 0.5rem; margin: 0.5rem 0; border-radius: 4px; font-family: monospace; font-size: 0.85rem; overflow-x: auto;">
                  GOOGLE_CLIENT_ID: 'YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com'
                </div>
              </li>
              <li>Deploy the updated file</li>
            </ol>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem;">
            See <strong>MSC_SURVEY_SETUP.md</strong> for detailed configuration instructions.
          </p>
        </div>
      `;
    }

      // Display user information in header
      function displayUserInfo() {
        if (!currentUser) return;

        const userSection = document.getElementById('userSection');
        if (!userSection) return;

        userSection.style.display = 'flex';
        document.getElementById('userName').textContent = currentUser.name.split(' ')[0];
        document.getElementById('userAvatar').src = currentUser.picture;
        document.getElementById('userAvatar').alt = currentUser.name;

        console.log('✅ User info displayed');
      }

      // Show survey form after login
      function showSurveyForm() {
        const loginSection = document.getElementById('loginSection');
        const formSection = document.getElementById('formSection');

        if (!loginSection || !formSection) return;

        loginSection.style.display = 'none';
        formSection.classList.add('active');
        updateProgress();

        console.log('✅ Survey form displayed');
      }

      // Update progress bar
      function updateProgress() {
        const form = document.getElementById('surveyForm');
        if (!form) return;

        const totalQuestions = 7;
        const requiredTextareas = form.querySelectorAll('textarea[required]');
        const filledQuestions = Array.from(requiredTextareas).filter(ta => ta.value.trim().length > 0).length;

        const progressPercentage = (filledQuestions / totalQuestions) * 100;
        const progressFill = document.getElementById('progressFill');

        if (progressFill) {
          progressFill.style.width = progressPercentage + '%';
        }

        document.getElementById('currentQuestion').textContent = filledQuestions;
      }

      // ===================================
      // FORM SUBMISSION
      // ===================================
      document.getElementById('surveyForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (!currentUser) {
          showStatus('Please sign in first', 'error');
          return;
        }

        if (hasSubmitted) {
          showStatus('You have already submitted this survey', 'error');
          return;
        }

        // Get submit button
        const submitBtn = e.target.querySelector('button[type="submit"]');
        const originalHtml = submitBtn.innerHTML;

        // Show loading state
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<div class="spinner"></div> Submitting...';
        showStatus('Submitting your survey...', 'loading');

        try {
          // Collect form data
          const formData = new FormData(e.target);
          const responses = Object.fromEntries(formData);

          // Validate required fields
          const requiredFields = ['q1', 'q2', 'q3', 'q4', 'q5', 'q6'];
          for (const field of requiredFields) {
            if (!responses[field] || responses[field].trim().length === 0) {
              throw new Error(`Required field "${field}" is empty`);
            }
          }

          // Build submission data
          const submissionData = {
            userId: currentUser.id,
            userEmail: currentUser.email,
            userName: currentUser.name,
            timestamp: new Date().toISOString(),
            ...responses
          };

          console.log('📤 Submitting survey data...');

          // Submit to backend
          const backendUrl = configManager.getBackendUrl();
          const response = await fetch(`${backendUrl}/submitSurvey`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(submissionData)
          });

          if (!response.ok) {
            const errorData = await response.json().catch(() => ({}));
            throw new Error(errorData.message || `Server error: ${response.statusText}`);
          }

          const result = await response.json();

          console.log('✅ Survey submitted successfully:', result);

          // Mark as submitted
          hasSubmitted = true;

          // Show success page
          showSuccessPage();

        } catch (error) {
          console.error('❌ Submission error:', error);
          showStatus(`Failed to submit survey: ${error.message}`, 'error');
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalHtml;
        }
      });

      // Show status message
      function showStatus(message, type) {
        const statusDiv = document.getElementById('statusMessage');
        if (!statusDiv) return;

        if (type === 'loading') {
          statusDiv.innerHTML = `<div class="status-message status-loading">
            <div class="spinner"></div>
            <span>${message}</span>
          </div>`;
        } else {
          statusDiv.innerHTML = `<div class="status-message status-${type}">${message}</div>`;
        }
      }

      // Show error
      function showError(message) {
        console.error('❌ Error:', message);
        document.getElementById('errorMessage').textContent = message;
        showErrorPage();
      }

      // Show success page
      function showSuccessPage() {
        document.getElementById('formSection').classList.remove('active');
        document.getElementById('successPage').classList.add('active');
        document.getElementById('submissionTime').textContent = new Date().toLocaleString();
        document.getElementById('userSection').style.display = 'none';
        console.log('✅ Survey completed successfully');
      }

      // Show error page
      function showErrorPage() {
        document.getElementById('formSection').classList.remove('active');
        document.getElementById('loginSection').style.display = 'none';
        document.getElementById('successPage').classList.remove('active');
        document.getElementById('errorPage').classList.add('active');
      }

      // ===================================
      // LOGOUT FUNCTIONALITY
      // ===================================
      document.getElementById('logoutBtn')?.addEventListener('click', () => {
        console.log('🚪 Logout requested');

        // Disable Google Sign-In auto select
        if (typeof google !== 'undefined' && google.accounts?.id) {
          google.accounts.id.disableAutoSelect();
        }

        // Reset state
        currentUser = null;
        hasSubmitted = false;

        // Reset UI
        document.getElementById('userSection').style.display = 'none';
        document.getElementById('formSection').classList.remove('active');
        document.getElementById('loginSection').style.display = 'block';
        document.getElementById('successPage').classList.remove('active');
        document.getElementById('errorPage').classList.remove('active');

        console.log('✅ Logged out successfully');

        // Redirect to homepage
        setTimeout(() => {
          window.location.href = 'https://alfredmayaki.me/';
        }, 500);
      });

      // Update progress as user types
      document.getElementById('surveyForm')?.addEventListener('input', updateProgress);

      // ===================================
      // PAGE INITIALIZATION
      // ===================================
    window.addEventListener('DOMContentLoaded', () => {
      console.log('🚀 MSC Survey app initializing...');
      let attempts = 0;
      const checkOAuth = setInterval(() => {
        if (
          (typeof google !== 'undefined' && google.accounts) &&
          (typeof firebase !== 'undefined' && firebase.auth)
        ) {
          clearInterval(checkOAuth);
          initializeOAuth();
        } else if (attempts > 30) {
          clearInterval(checkOAuth);
          console.error('❌ OAuth SDKs failed to load');
          showConfigurationError();
        }
        attempts++;
      }, 100);
    });
    </script>
