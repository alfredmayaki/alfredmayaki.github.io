<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>MSc References — Alfred Mayaki</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="References for FBL-PhD Research Proposal by Alfred Anate Bodurin Mayaki">
  <meta name="author" content="Alfred Anate Bodurin Mayaki">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root {
      --font-sans: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
      --bg: #0f0f0f;
      --bg-overlay: rgba(22, 22, 22, 0.92);
      --panel: #161616;
      --panel-2: #141414;
      --surface: #2a2a2a;
      --text: #ffffff;
      --text-muted: #979797;
      --text-secondary: #b0b0b0;
      --border: #464242;
      --brand: #3d4ee9;
      --brand-hover: #5563f0;
      --green: #10b981;
      --amber: #f59e0b;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html {
      background: url("/universe.png") center / cover no-repeat fixed;
      background-color: var(--bg);
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-sans);
      color: var(--text-muted);
      background: transparent;
      min-height: 100vh;
      padding: 1em;
    }

    /* ============ HEADER ============ */
    .header {
      max-width: 900px;
      margin: 0 auto 2em;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.6rem 1.2rem;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s;
      font-size: 0.9rem;
      font-weight: 500;
      white-space: nowrap;
    }

    .back-btn:hover {
      background: var(--brand);
      border-color: var(--brand);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(61, 78, 233, 0.4);
    }

    .header-title {
      flex: 1;
      min-width: 200px;
    }

    .header-title h1 {
      font-size: 2em;
      color: var(--text);
      margin-bottom: 0.5rem;
    }

    .header-subtitle {
      font-size: 0.95rem;
      color: var(--text-secondary);
    }

    /* ============ MAIN CONTAINER ============ */
    .container {
      max-width: 900px;
      margin: 0 auto;
      background: var(--bg-overlay);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2rem;
    }

    /* ============ SECTION HEADER ============ */
    .section-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid var(--border);
    }

    .section-icon {
      font-size: 1.5rem;
      color: var(--brand);
    }

    .section-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text);
    }

    .section-info {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-top: 0.5rem;
    }

    /* ============ REFERENCE ITEM ============ */
    .reference-item {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      transition: all 0.3s;
      animation: slideIn 0.4s ease-out;
    }

    @keyframes slideIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .reference-item:hover {
      border-color: var(--brand);
      background: var(--panel);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(61, 78, 233, 0.15);
    }

    .reference-number {
      display: inline-block;
      background: var(--brand);
      color: white;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 0.9rem;
      margin-bottom: 1rem;
    }

    .reference-text {
      color: var(--text);
      line-height: 1.7;
      margin-bottom: 1rem;
      font-size: 0.95rem;
    }

    .reference-authors {
      color: var(--text);
      font-weight: 600;
    }

    .reference-year {
      color: var(--text-secondary);
      font-style: italic;
    }

    .reference-title {
      color: var(--text);
      font-weight: 500;
    }

    .reference-publication {
      color: var(--text-muted);
    }

    .reference-links {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }

    .ref-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: var(--panel);
      color: var(--brand);
      border: 1px solid var(--brand);
      border-radius: 6px;
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
      transition: all 0.2s;
    }

    .ref-link:hover {
      background: var(--brand);
      color: white;
      transform: translateY(-1px);
      box-shadow: 0 2px 8px rgba(61, 78, 233, 0.3);
    }

    .ref-link i {
      font-size: 0.9rem;
    }

    /* ============ FILTERS ============ */
    .filter-section {
      margin-bottom: 2rem;
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      align-items: center;
    }

    .filter-label {
      font-weight: 600;
      color: var(--text);
      font-size: 0.9rem;
    }

    .filter-btn {
      padding: 0.5rem 1rem;
      background: var(--panel);
      color: var(--text-secondary);
      border: 1px solid var(--border);
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.85rem;
      transition: all 0.2s;
    }

    .filter-btn:hover,
    .filter-btn.active {
      background: var(--brand);
      color: white;
      border-color: var(--brand);
    }

    /* ============ STATS ============ */
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1rem;
      text-align: center;
    }

    .stat-number {
      font-size: 2rem;
      font-weight: 700;
      color: var(--brand);
    }

    .stat-label {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-top: 0.5rem;
    }

    /* ============ SEARCH ============ */
    .search-box {
      width: 100%;
      margin-bottom: 2rem;
    }

    .search-input {
      width: 100%;
      padding: 0.85rem 1rem;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      font-family: var(--font-sans);
      font-size: 0.95rem;
      transition: all 0.2s;
    }

    .search-input:focus {
      outline: none;
      border-color: var(--brand);
      box-shadow: 0 0 0 3px rgba(61, 78, 233, 0.2);
      background: var(--panel);
    }

    .search-input::placeholder {
      color: var(--text-muted);
    }

    /* ============ EMPTY STATE ============ */
    .empty-state {
      text-align: center;
      padding: 3rem 2rem;
      color: var(--text-muted);
    }

    .empty-state i {
      font-size: 3rem;
      margin-bottom: 1rem;
      opacity: 0.5;
    }

    .empty-state h3 {
      color: var(--text);
      margin-bottom: 0.5rem;
    }

    /* ============ FOOTER ============ */
    .footer {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
      text-align: center;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .footer a {
      color: var(--brand);
      text-decoration: none;
      transition: color 0.2s;
    }

    .footer a:hover {
      color: var(--brand-hover);
      text-decoration: underline;
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 768px) {
      body { padding: 0.5em; }
      .container { padding: 1.5rem; }
      .header { flex-direction: column; align-items: flex-start; }
      .header-title h1 { font-size: 1.5em; }
      .reference-item { padding: 1rem; }
      .stats { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 480px) {
      .container { padding: 1rem; }
      .section-title { font-size: 1.25rem; }
      .reference-text { font-size: 0.9rem; }
      .reference-links { flex-direction: column; }
      .ref-link { width: 100%; justify-content: center; }
      .stats { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <!-- Header with Back Button -->
  <div class="header">
    <a href="index.html" class="back-btn">
      <i class="fas fa-arrow-left"></i>
      Back to Home
    </a>
    <div class="header-title">
      <h1>📚 MSc References</h1>
      <span class="header-subtitle">FBL-PhD Research Proposal — Supervised by Dr. Nicola J. Bowman</span>
    </div>
  </div>

  <!-- Main Container -->
  <div class="container">
    <!-- Stats Section -->
    <div class="stats">
      <div class="stat-card">
        <div class="stat-number" id="totalRefs">0</div>
        <div class="stat-label">Total References</div>
      </div>
      <div class="stat-card">
        <div class="stat-number" id="journalCount">0</div>
        <div class="stat-label">Journal Articles</div>
      </div>
      <div class="stat-card">
        <div class="stat-number" id="bookCount">0</div>
        <div class="stat-label">Books</div>
      </div>
      <div class="stat-card">
        <div class="stat-number" id="otherCount">0</div>
        <div class="stat-label">Other Sources</div>
      </div>
    </div>

    <!-- Search Box -->
    <div class="search-box">
      <input type="text" id="searchInput" class="search-input" placeholder="🔍 Search references by author, year, title...">
    </div>

    <!-- Filter Section -->
    <div class="filter-section">
      <span class="filter-label">Filter by type:</span>
      <button class="filter-btn active" onclick="filterByType('all')">All</button>
      <button class="filter-btn" onclick="filterByType('journal')">Journal Articles</button>
      <button class="filter-btn" onclick="filterByType('book')">Books</button>
      <button class="filter-btn" onclick="filterByType('other')">Other</button>
    </div>

    <!-- Section Header -->
    <div class="section-header">
      <i class="fas fa-book section-icon"></i>
      <div>
        <h2 class="section-title">References</h2>
        <p class="section-info" id="refCount">Loading references...</p>
      </div>
    </div>

    <!-- References List -->
    <div id="referencesList">
      <div class="empty-state">
        <i class="fas fa-hourglass-half"></i>
        <h3>Loading references...</h3>
        <p>Please provide your references from the FBL-PhD-research-proposal.pdf file</p>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <p>© 2026 Alfred Anate Bodurin Mayaki</p>
      <p>References extracted from: <strong>FBL-PhD Research Proposal</strong></p>
      <p>For the full research proposal, <a href="https://alfredmayaki.me/FBL-PhD-research-proposal.pdf" target="_blank">click here</a></p>
    </div>
  </div>

  <script>
    // Reference Data Structure - EDIT THIS WITH YOUR REFERENCES FROM THE PDF
    const references = [
      {
        id: 1,
        authors: "Acemoglu, D., & Robinson, J. A.",
        year: 2012,
        title: "Why nations fail: The origins of power, prosperity, and poverty",
        publication: "Crown Business",
        type: "book",
        doi: null,
        url: "https://www.whynationsfail.com/"
      },
      {
        id: 2,
        authors: "Angrist, J. D., & Pischke, J. S.",
        year: 2009,
        title: "Mostly harmless econometrics: An empiricist's companion",
        publication: "Princeton University Press",
        type: "book",
        doi: null,
        url: "https://www.mostlyharmlesseconometrics.com/"
      },
      {
        id: 3,
        authors: "Arrow, K. J.",
        year: 1963,
        title: "Uncertainty and the welfare economics of medical care",
        publication: "American Economic Review, 53(5), 941-973",
        type: "journal",
        doi: "10.2307/1812044",
        url: "https://doi.org/10.2307/1812044"
      },
      // ADD MORE REFERENCES HERE - COPY THE STRUCTURE ABOVE
      // Remember to update the 'type' field: 'journal', 'book', or 'other'
      // Add DOI links where available
    ];

    let currentFilter = 'all';
    let filteredReferences = references;

    // Initialize on page load
    window.addEventListener('DOMContentLoaded', () => {
      renderReferences();
      updateStats();
      setupSearch();
    });

    // Render References
    function renderReferences() {
      const container = document.getElementById('referencesList');

      if (filteredReferences.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <i class="fas fa-filter"></i>
            <h3>No references found</h3>
            <p>Try adjusting your filters or search terms</p>
          </div>
        `;
        document.getElementById('refCount').textContent = 'No references to display';
        return;
      }

      container.innerHTML = filteredReferences.map((ref, index) => `
        <div class="reference-item" data-type="${ref.type}">
          <div class="reference-number">${index + 1}</div>
          
          <div class="reference-text">
            <span class="reference-authors">${ref.authors}</span>
            <span class="reference-year">(${ref.year}).</span>
            <span class="reference-title">"${ref.title}"</span>
            <span class="reference-publication">. ${ref.publication}</span>
          </div>

          <div class="reference-links">
            ${ref.doi ? `
              <a href="${ref.url || `https://doi.org/${ref.doi}`}" target="_blank" rel="noopener noreferrer" class="ref-link">
                <i class="fas fa-link"></i>
                DOI: ${ref.doi}
              </a>
            ` : ''}
            ${ref.url && !ref.doi ? `
              <a href="${ref.url}" target="_blank" rel="noopener noreferrer" class="ref-link">
                <i class="fas fa-external-link-alt"></i>
                View Online
              </a>
            ` : ''}
            <button class="ref-link" onclick="copyReference(${ref.id})" style="background: var(--panel); border-color: var(--text-muted); color: var(--text-secondary);">
              <i class="fas fa-copy"></i>
              Copy Citation
            </button>
          </div>
        </div>
      `).join('');

      document.getElementById('refCount').textContent = `Showing ${filteredReferences.length} reference(s)`;
    }

    // Update Statistics
    function updateStats() {
      document.getElementById('totalRefs').textContent = references.length;
      document.getElementById('journalCount').textContent = references.filter(r => r.type === 'journal').length;
      document.getElementById('bookCount').textContent = references.filter(r => r.type === 'book').length;
      document.getElementById('otherCount').textContent = references.filter(r => r.type === 'other').length;
    }

    // Filter by Type
    function filterByType(type) {
      currentFilter = type;
      
      // Update button states
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      event.target.classList.add('active');

      // Filter references
      if (type === 'all') {
        filteredReferences = references;
      } else {
        filteredReferences = references.filter(r => r.type === type);
      }

      renderReferences();
    }

    // Setup Search
    function setupSearch() {
      const searchInput = document.getElementById('searchInput');
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase();
        
        if (query === '') {
          currentFilter === 'all' 
            ? filteredReferences = references 
            : filteredReferences = references.filter(r => r.type === currentFilter);
        } else {
          filteredReferences = references.filter(ref => {
            const matches = 
              ref.authors.toLowerCase().includes(query) ||
              ref.title.toLowerCase().includes(query) ||
              ref.publication.toLowerCase().includes(query) ||
              ref.year.toString().includes(query);
            
            if (currentFilter === 'all') return matches;
            return matches && ref.type === currentFilter;
          });
        }
        
        renderReferences();
      });
    }

    // Copy Citation
    function copyReference(id) {
      const ref = references.find(r => r.id === id);
      const citation = `${ref.authors} (${ref.year}). "${ref.title}". ${ref.publication}`;
      
      navigator.clipboard.writeText(citation).then(() => {
        alert('Reference copied to clipboard!');
      }).catch(err => {
        console.error('Failed to copy:', err);
      });
    }
  </script>
</body>
</html>
