name = "search-tracker"
main = "search-tracker.js"
compatibility_date = "2024-01-15"

# KV Namespace for storing search data
kv_namespaces = [
  { binding = "SEARCH_DATA", id = "721c412d71b449e2ab97569edacb7fd7" }
]

# Routes - replace with your domain
routes = [
  { pattern = "alfredmayaki.me/api/search/*", zone_name = "alfredmayaki.me" }
]

# Or use workers.dev subdomain for testing
# workers_dev = true

[build]
command = ""

# Optional: Separate environments (uncomment and configure if needed)
# [env.production]
# kv_namespaces = [
#   { binding = "SEARCH_DATA", id = "721c412d71b449e2ab97569edacb7fd7" }
# ]
