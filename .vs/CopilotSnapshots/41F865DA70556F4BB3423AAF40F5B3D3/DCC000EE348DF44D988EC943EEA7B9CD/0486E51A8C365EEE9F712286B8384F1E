<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Cloudflare Analytics Report — Alfred A. B. Mayaki</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Cloudflare analytics dashboard showing unique visitors and total requests over a 28-day period.">
  <meta name="author" content="Alfred Anate Bodurin Mayaki">

  <style>
    :root {
      --font-sans: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;

      --bg-overlay: rgba(22, 22, 22, 0.92);
      --panel: #161616;
      --panel-2: #141414;
      --surface: #2a2a2a;

      --text: #ffffff;
      --text-muted: #979797;

      --border: #464242;
      --border-soft: rgba(255, 255, 255, 0.06);

      --brand: #3d4ee9;
      --brand-hover: #5563f0;

      --success: #10b981;
      --error: #ef4444;
      --warning: #f59e0b;

      --radius-sm: 10px;
      --radius-md: 14px;
      --radius-lg: 16px;
      --radius-pill: 999px;

      --shadow-pop: 0 14px 40px rgba(0, 0, 0, 0.55);
      --shadow-brand: 0 6px 16px rgba(61, 78, 233, 0.35);

      --space-1: 8px;
      --space-2: 10px;
      --space-3: 12px;
      --space-4: 16px;
      --space-5: 24px;
      --space-6: 32px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      padding: 5px;

      display: flex;
      align-items: stretch;
      justify-content: stretch;

      font-family: var(--font-sans);
      color: var(--text-muted);
      background: url("universe.png") center / cover no-repeat fixed;
    }

    .container {
      width: 100%;
      min-height: 100vh;

      display: flex;
      flex-direction: column;

      padding: 2em;
      background: var(--bg-overlay);
      border: 3px solid var(--border);
      animation: fadeIn 0.7s ease-in;
      overflow-y: auto;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Back to Home Button */
    .back-home-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 20px;
      margin-bottom: 1.5em;
      min-height: 44px;

      background: #3d4ee9;
      color: #ffffff !important;
      border: 2px solid #3d4ee9;
      border-radius: 999px;

      font-family: 'Segoe UI', sans-serif;
      font-size: 0.9em;
      font-weight: 600;
      text-decoration: none !important;
      white-space: nowrap;

      transition: all 0.2s ease;
      cursor: pointer;
    }

    .back-home-btn:hover {
      background: #5563f0;
      border-color: #5563f0;
      box-shadow: 0 4px 12px rgba(61, 78, 233, 0.4);
      transform: translateY(-2px);
      text-decoration: none !important;
      color: #ffffff !important;
    }

    .back-home-btn:active {
      transform: translateY(0);
      box-shadow: 0 2px 8px rgba(61, 78, 233, 0.3);
    }

    /* Mobile optimization */
    @media (max-width: 768px) {
      .back-home-btn {
        padding: 12px 24px;
        font-size: 1em;
        min-height: 48px;
        gap: 10px;
      }
    }

    h1 {
      margin: 0 0 0.3em 0;
      font-size: 2em;
      color: var(--text);
      text-align: center;
    }

    .subtitle {
      margin: 0 0 2em 0;
      font-size: 1em;
      color: var(--text-muted);
      text-align: center;
    }

    .credentials-section {
      max-width: 800px;
      margin: 0 auto 2em;
      padding: 1.5em;
      background: var(--panel);
      border: 2px solid var(--border);
      border-radius: var(--radius-lg);
    }

    .credentials-section h2 {
      margin: 0 0 1em 0;
      font-size: 1.3em;
      color: var(--text);
    }

    .form-group {
      margin-bottom: 1em;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.5em;
      color: var(--text);
      font-size: 0.95em;
      font-weight: 500;
    }

    .form-group input {
      width: 100%;
      padding: 0.85em 1em;

      color: var(--text);
      background: var(--surface);
      border: 2px solid var(--border);
      border-radius: var(--radius-md);

      font-family: var(--font-sans);
      font-size: 0.95em;
      outline: none;

      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-group input:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(61, 78, 233, 0.2);
    }

    .form-group small {
      display: block;
      margin-top: 0.4em;
      color: var(--text-muted);
      font-size: 0.85em;
    }

    .button-group {
      display: flex;
      gap: 1em;
      margin-top: 1.5em;
      flex-wrap: wrap;
    }

    .btn {
      flex: 1;
      min-width: 140px;
      padding: 0.85em 1.5em;

      color: var(--text);
      background: var(--brand);
      border: 2px solid var(--brand);
      border-radius: var(--radius-md);

      font-family: var(--font-sans);
      font-size: 0.95em;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;

      transition: all 0.2s ease;
    }

    .btn:hover {
      background: var(--brand-hover);
      box-shadow: var(--shadow-brand);
      transform: translateY(-1px);
    }

    .btn:active {
      transform: translateY(0);
      box-shadow: none;
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    .btn-secondary {
      background: var(--surface);
      border-color: var(--border);
    }

    .btn-secondary:hover {
      background: var(--brand);
      border-color: var(--brand);
    }

    .alert {
      padding: 1em 1.2em;
      margin-bottom: 1.5em;
      border-radius: var(--radius-md);
      border-left: 4px solid;
      animation: slideIn 0.3s ease-out;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .alert-success {
      background: rgba(16, 185, 129, 0.1);
      border-color: var(--success);
      color: var(--success);
    }

    .alert-error {
      background: rgba(239, 68, 68, 0.1);
      border-color: var(--error);
      color: var(--error);
    }

    .alert-warning {
      background: rgba(245, 158, 11, 0.1);
      border-color: var(--warning);
      color: var(--warning);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5em;
      margin-bottom: 2em;
      max-width: 1200px;
      margin-left: auto;
      margin-right: auto;
    }

    .stat-card {
      padding: 1.5em;
      background: var(--panel);
      border: 2px solid var(--border);
      border-radius: var(--radius-lg);
      text-align: center;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-pop);
    }

    .stat-card h3 {
      margin: 0 0 0.5em 0;
      font-size: 0.9em;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .stat-value {
      font-size: 2.5em;
      font-weight: 700;
      color: var(--brand);
      margin: 0;
    }

    .stat-change {
      margin-top: 0.5em;
      font-size: 0.9em;
    }

    .stat-change.positive {
      color: var(--success);
    }

    .stat-change.negative {
      color: var(--error);
    }

    .chart-section {
      max-width: 1200px;
      margin: 0 auto 2em;
      padding: 1.5em;
      background: var(--panel);
      border: 2px solid var(--border);
      border-radius: var(--radius-lg);
    }

    .chart-section h2 {
      margin: 0 0 1em 0;
      font-size: 1.3em;
      color: var(--text);
      text-align: center;
    }

    .chart-container {
      position: relative;
      height: 400px;
      margin-top: 1em;
    }

    .loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 3em;
      color: var(--text-muted);
    }

    .spinner {
      width: 50px;
      height: 50px;
      border: 4px solid var(--border);
      border-top-color: var(--brand);
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin-bottom: 1em;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .date-range {
      display: flex;
      gap: 1em;
      align-items: center;
      margin-bottom: 1.5em;
      flex-wrap: wrap;
    }

    .date-range label {
      color: var(--text);
      font-weight: 500;
    }

    .date-range input[type="date"] {
      padding: 0.7em 1em;
      color: var(--text);
      background: var(--surface);
      border: 2px solid var(--border);
      border-radius: var(--radius-md);
      font-family: var(--font-sans);
      font-size: 0.9em;
      outline: none;
      cursor: pointer;
      transition: border-color 0.2s ease;
    }

    .date-range input[type="date"]:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(61, 78, 233, 0.2);
    }

    /* Color scheme for date inputs */
    .date-range input[type="date"]::-webkit-calendar-picker-indicator {
      filter: invert(1);
      cursor: pointer;
    }

    .footer {
      margin-top: auto;
      padding-top: 2em;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.9em;
      border-top: 1px solid var(--border);
    }

    @media (max-width: 768px) {
      .container {
        padding: 1.5em 1em;
      }

      h1 {
        font-size: 1.5em;
      }

      .chart-container {
        height: 300px;
      }

      .button-group {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }

      .date-range {
        flex-direction: column;
        align-items: stretch;
      }

      .date-range input[type="date"] {
        width: 100%;
      }
    }

    @media (max-width: 480px) {
      .stats-grid {
        grid-template-columns: 1fr;
      }

      .stat-value {
        font-size: 2em;
      }
    }
  </style>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <div id="particles-js" style="position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:-1;"></div>

  <div class="container">
    <!-- Back to Home Button -->
    <div style="margin-bottom: 1.3em;">
      <a href="index.html" class="back-home-btn">
        <i class="fas fa-arrow-left"></i>
        Back to Home
      </a>
    </div>

    <h1>📊 Cloudflare Analytics Report</h1>
    <p class="subtitle">28-Day Traffic Analysis Dashboard</p>

    <div id="alertContainer"></div>

    <!-- Troubleshooting Notice -->
    <div class="credentials-section" style="background: rgba(245, 158, 11, 0.1); border-color: var(--warning);">
      <h2>⚠️ Important: CORS Limitations</h2>
      <p style="color: var(--text); line-height: 1.6; margin: 0;">
        <strong>Direct browser requests to Cloudflare's API may be blocked due to CORS policies.</strong><br><br>
        If you encounter "Failed to fetch" errors, you'll need to use one of these solutions:
      </p>
      <ul style="color: var(--text-muted); line-height: 1.8; margin-top: 1em;">
        <li><strong>Option 1 (Recommended):</strong> Create a Cloudflare Worker as a proxy for your API requests</li>
        <li><strong>Option 2:</strong> Use a backend server (Node.js, Python, etc.) to make the API calls</li>
        <li><strong>Option 3:</strong> View analytics directly in your Cloudflare Dashboard</li>
        <li><strong>Option 4 (Dev Only):</strong> Use a CORS browser extension or disable web security (not recommended for production)</li>
      </ul>
      <p style="color: var(--text-muted); margin-top: 1em; font-size: 0.9em;">
        💡 <strong>Tip:</strong> Check your browser's console (F12) for detailed error messages.
      </p>
    </div>

    <!-- Credentials Section -->
    <div class="credentials-section">
      <h2>🔐 API Credentials</h2>
      <div class="form-group">
        <label for="apiToken">API Token</label>
        <input type="password" id="apiToken" placeholder="Enter your Cloudflare API Token">
        <small>Create a token with <strong>Analytics:Read</strong> permissions in your Cloudflare dashboard</small>
      </div>

      <div class="form-group">
        <label for="zoneId">Zone ID</label>
        <input type="text" id="zoneId" placeholder="Enter your Zone ID">
        <small>Found in your domain's Overview page → API section</small>
      </div>

      <div class="form-group">
        <label for="accountId">Account ID</label>
        <input type="text" id="accountId" placeholder="Enter your Account ID">
        <small>Found in your Cloudflare dashboard under Account → Workers</small>
      </div>

      <div class="date-range">
        <label>Date Range:</label>
        <input type="date" id="startDate" />
        <span style="color: var(--text-muted);">to</span>
        <input type="date" id="endDate" />
      </div>

      <div class="button-group">
        <button class="btn" id="fetchDataBtn">
          <i class="fas fa-chart-line"></i> Fetch Analytics
        </button>
        <button class="btn btn-secondary" id="demoBtn">
          <i class="fas fa-play"></i> View Demo Data
        </button>
        <button class="btn btn-secondary" id="saveCredentialsBtn">
          <i class="fas fa-save"></i> Save Credentials
        </button>
        <button class="btn btn-secondary" id="clearCredentialsBtn">
          <i class="fas fa-trash"></i> Clear Saved Data
        </button>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid" id="statsGrid" style="display: none;">
      <div class="stat-card">
        <h3>Total Requests</h3>
        <p class="stat-value" id="totalRequests">-</p>
        <p class="stat-change" id="requestsChange"></p>
      </div>
      <div class="stat-card">
        <h3>Unique Visitors</h3>
        <p class="stat-value" id="uniqueVisitors">-</p>
        <p class="stat-change" id="visitorsChange"></p>
      </div>
      <div class="stat-card">
        <h3>Bandwidth Used</h3>
        <p class="stat-value" id="bandwidthUsed">-</p>
        <p class="stat-change" id="bandwidthChange"></p>
      </div>
      <div class="stat-card">
        <h3>Cache Hit Rate</h3>
        <p class="stat-value" id="cacheHitRate">-</p>
        <p class="stat-change" id="cacheChange"></p>
      </div>
    </div>

    <!-- Charts -->
    <div class="chart-section" id="requestsChartSection" style="display: none;">
      <h2>📈 Requests Over Time</h2>
      <div class="chart-container">
        <canvas id="requestsChart"></canvas>
      </div>
    </div>

    <div class="chart-section" id="visitorsChartSection" style="display: none;">
      <h2>👥 Unique Visitors Over Time</h2>
      <div class="chart-container">
        <canvas id="visitorsChart"></canvas>
      </div>
    </div>

    <div class="footer">
      <p>© 2026 Alfred A. B. Mayaki. All rights reserved.</p>
      <p style="margin-top: 0.5em;">Powered by Cloudflare Analytics API</p>
    </div>
  </div>

  <!-- Particles.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/particles.js/2.0.0/particles.min.js"></script>

  <script>
    // Initialize particles.js
    if (typeof particlesJS !== 'undefined') {
      particlesJS('particles-js', {
        particles: {
          number: { value: 80, density: { enable: true, value_area: 800 } },
          color: { value: '#3d4ee9' },
          shape: { type: 'circle' },
          opacity: { value: 0.5, random: false },
          size: { value: 3, random: true },
          line_linked: {
            enable: true,
            distance: 150,
            color: '#3d4ee9',
            opacity: 0.4,
            width: 1
          },
          move: { enable: true, speed: 2, direction: 'none', random: false, straight: false, out_mode: 'out', bounce: false }
        },
        interactivity: {
          detect_on: 'canvas',
          events: { onhover: { enable: true, mode: 'repulse' }, onclick: { enable: true, mode: 'push' }, resize: true },
          modes: { repulse: { distance: 100, duration: 0.4 }, push: { particles_nb: 4 } }
        },
        retina_detect: true
      });
    }

    // Global variables
    let requestsChart = null;
    let visitorsChart = null;

    // Initialize date inputs with default 28-day range
    function initializeDateInputs() {
      const endDate = new Date();
      const startDate = new Date();
      startDate.setDate(startDate.getDate() - 28);

      document.getElementById('endDate').valueAsDate = endDate;
      document.getElementById('startDate').valueAsDate = startDate;
    }

    // Show alert message
    function showAlert(message, type = 'error') {
      const alertContainer = document.getElementById('alertContainer');
      const alert = document.createElement('div');
      alert.className = `alert alert-${type}`;
      alert.innerHTML = `<strong>${type === 'error' ? '❌' : type === 'success' ? '✅' : '⚠️'}</strong> ${message}`;
      alertContainer.innerHTML = '';
      alertContainer.appendChild(alert);

      if (type === 'success') {
        setTimeout(() => {
          alert.remove();
        }, 5000);
      }
    }

    // Format numbers with commas
    function formatNumber(num) {
      return new Intl.NumberFormat('en-US').format(num);
    }

    // Format bytes to human readable
    function formatBytes(bytes) {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    // Save credentials to localStorage
    function saveCredentials() {
      const credentials = {
        apiToken: document.getElementById('apiToken').value,
        zoneId: document.getElementById('zoneId').value,
        accountId: document.getElementById('accountId').value
      };

      if (!credentials.apiToken || !credentials.zoneId) {
        showAlert('API Token and Zone ID are required', 'warning');
        return;
      }

      localStorage.setItem('cloudflare_credentials', JSON.stringify(credentials));
      showAlert('Credentials saved successfully! (stored locally)', 'success');
    }

    // Load saved credentials
    function loadCredentials() {
      const saved = localStorage.getItem('cloudflare_credentials');
      if (saved) {
        const credentials = JSON.parse(saved);
        document.getElementById('apiToken').value = credentials.apiToken || '';
        document.getElementById('zoneId').value = credentials.zoneId || '';
        document.getElementById('accountId').value = credentials.accountId || '';
      }
    }

    // Clear saved credentials
    function clearCredentials() {
      localStorage.removeItem('cloudflare_credentials');
      document.getElementById('apiToken').value = '';
      document.getElementById('zoneId').value = '';
      document.getElementById('accountId').value = '';
      showAlert('Credentials cleared', 'success');
    }

    // Fetch analytics data from Cloudflare
    async function fetchCloudflareAnalytics() {
      const apiToken = document.getElementById('apiToken').value.trim();
      const zoneId = document.getElementById('zoneId').value.trim();
      const startDate = document.getElementById('startDate').value;
      const endDate = document.getElementById('endDate').value;

      if (!apiToken || !zoneId) {
        showAlert('Please provide API Token and Zone ID', 'warning');
        return;
      }

      if (!startDate || !endDate) {
        showAlert('Please select a valid date range', 'warning');
        return;
      }

      // Show loading state
      const fetchBtn = document.getElementById('fetchDataBtn');
      fetchBtn.disabled = true;
      fetchBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading...';

      try {
        // Format dates for Cloudflare API
        const since = startDate;
        const until = endDate;

        // Try REST API first (better CORS support)
        const restUrl = `https://api.cloudflare.com/client/v4/zones/${zoneId}/analytics/dashboard?since=${since}&until=${until}&continuous=true`;

        console.log('Fetching from Cloudflare Analytics API...');

        const response = await fetch(restUrl, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${apiToken}`,
            'Content-Type': 'application/json'
          }
        });

        console.log('Response status:', response.status);

        if (!response.ok) {
          const errorText = await response.text();
          console.error('API Error Response:', errorText);

          if (response.status === 403) {
            throw new Error('Access denied. Please check your API token has "Analytics:Read" permission.');
          } else if (response.status === 401) {
            throw new Error('Authentication failed. Please verify your API token is correct.');
          } else if (response.status === 404) {
            throw new Error('Zone not found. Please verify your Zone ID is correct.');
          } else {
            throw new Error(`API Error: ${response.status} ${response.statusText}`);
          }
        }

        const data = await response.json();
        console.log('API Response:', data);

        if (!data.success) {
          const errorMsg = data.errors?.[0]?.message || 'Unknown API error';
          throw new Error(errorMsg);
        }

        if (!data.result || !data.result.timeseries) {
          throw new Error('No analytics data found. This might be due to:\n• CORS restrictions (browser blocking cross-origin requests)\n• Insufficient API permissions\n• No data for selected date range\n\nSee console for details.');
        }

        processAndDisplayRestData(data.result);
        showAlert('Analytics data fetched successfully!', 'success');

      } catch (error) {
        console.error('Error fetching analytics:', error);

        let errorMessage = error.message;

        // Check if it's a CORS error
        if (error.message.includes('Failed to fetch') || error.message.includes('CORS')) {
          errorMessage = 'CORS Error: Browser blocked the request.\n\n' +
            '⚠️ Solution Options:\n' +
            '1. Use Cloudflare Workers as a proxy\n' +
            '2. Run this from a backend server\n' +
            '3. Use Cloudflare Dashboard instead\n' +
            '4. Disable browser CORS (development only)\n\n' +
            'See browser console for more details.';
        }

        showAlert(errorMessage, 'error');
      } finally {
        fetchBtn.disabled = false;
        fetchBtn.innerHTML = '<i class="fas fa-chart-line"></i> Fetch Analytics';
      }
    }

    // Process REST API response
    function processAndDisplayRestData(result) {
      const timeseries = result.timeseries;

      if (!timeseries || timeseries.length === 0) {
        showAlert('No data available for the selected date range', 'warning');
        return;
      }

      // Extract data for charts
      const dates = timeseries.map(d => {
        const date = new Date(d.since);
        return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      });

      const requests = timeseries.map(d => d.requests.all || 0);
      const visitors = timeseries.map(d => d.uniques.all || 0);
      const bytes = timeseries.map(d => d.bytes.all || 0);
      const cachedRequests = timeseries.map(d => d.requests.cached || 0);

      // Calculate totals from result.totals if available
      const totals = result.totals || {};
      const totalRequests = totals.requests?.all || requests.reduce((a, b) => a + b, 0);
      const totalVisitors = totals.uniques?.all || visitors.reduce((a, b) => a + b, 0);
      const totalBytes = totals.bytes?.all || bytes.reduce((a, b) => a + b, 0);
      const totalCachedRequests = totals.requests?.cached || cachedRequests.reduce((a, b) => a + b, 0);
      const cacheHitRate = totalRequests > 0 ? ((totalCachedRequests / totalRequests) * 100).toFixed(1) : 0;

      // Update stats cards
      document.getElementById('totalRequests').textContent = formatNumber(totalRequests);
      document.getElementById('uniqueVisitors').textContent = formatNumber(totalVisitors);
      document.getElementById('bandwidthUsed').textContent = formatBytes(totalBytes);
      document.getElementById('cacheHitRate').textContent = cacheHitRate + '%';

      // Calculate trends (compare first half vs second half)
      const midpoint = Math.floor(requests.length / 2);
      const firstHalfRequests = requests.slice(0, midpoint).reduce((a, b) => a + b, 0);
      const secondHalfRequests = requests.slice(midpoint).reduce((a, b) => a + b, 0);
      const requestsTrend = firstHalfRequests > 0 ? ((secondHalfRequests - firstHalfRequests) / firstHalfRequests * 100).toFixed(1) : 0;

      const firstHalfVisitors = visitors.slice(0, midpoint).reduce((a, b) => a + b, 0);
      const secondHalfVisitors = visitors.slice(midpoint).reduce((a, b) => a + b, 0);
      const visitorsTrend = firstHalfVisitors > 0 ? ((secondHalfVisitors - firstHalfVisitors) / firstHalfVisitors * 100).toFixed(1) : 0;

      // Update trend indicators
      const requestsChangeEl = document.getElementById('requestsChange');
      requestsChangeEl.textContent = `${requestsTrend > 0 ? '↑' : '↓'} ${Math.abs(requestsTrend)}% vs previous period`;
      requestsChangeEl.className = `stat-change ${requestsTrend >= 0 ? 'positive' : 'negative'}`;

      const visitorsChangeEl = document.getElementById('visitorsChange');
      visitorsChangeEl.textContent = `${visitorsTrend > 0 ? '↑' : '↓'} ${Math.abs(visitorsTrend)}% vs previous period`;
      visitorsChangeEl.className = `stat-change ${visitorsTrend >= 0 ? 'positive' : 'negative'}`;

      // Show stats and charts
      document.getElementById('statsGrid').style.display = 'grid';
      document.getElementById('requestsChartSection').style.display = 'block';
      document.getElementById('visitorsChartSection').style.display = 'block';

      // Create/update requests chart
      createOrUpdateChart('requestsChart', 'Requests', dates, requests, 'rgba(61, 78, 233, 0.2)', '#3d4ee9');

      // Create/update visitors chart
      createOrUpdateChart('visitorsChart', 'Unique Visitors', dates, visitors, 'rgba(16, 185, 129, 0.2)', '#10b981');
    }

    // Process and display analytics data
    function processAndDisplayData(data) {
      // Sort data by date
      data.sort((a, b) => new Date(a.dimensions.date) - new Date(b.dimensions.date));

      // Extract data for charts
      const dates = data.map(d => {
        const date = new Date(d.dimensions.date);
        return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      });
      const requests = data.map(d => d.sum.requests);
      const visitors = data.map(d => d.uniq.uniques);
      const bytes = data.map(d => d.sum.bytes);
      const cachedRequests = data.map(d => d.sum.cachedRequests);

      // Calculate totals
      const totalRequests = requests.reduce((a, b) => a + b, 0);
      const totalVisitors = visitors.reduce((a, b) => a + b, 0);
      const totalBytes = bytes.reduce((a, b) => a + b, 0);
      const totalCachedRequests = cachedRequests.reduce((a, b) => a + b, 0);
      const cacheHitRate = totalRequests > 0 ? ((totalCachedRequests / totalRequests) * 100).toFixed(1) : 0;

      // Update stats cards
      document.getElementById('totalRequests').textContent = formatNumber(totalRequests);
      document.getElementById('uniqueVisitors').textContent = formatNumber(totalVisitors);
      document.getElementById('bandwidthUsed').textContent = formatBytes(totalBytes);
      document.getElementById('cacheHitRate').textContent = cacheHitRate + '%';

      // Calculate trends (compare first half vs second half)
      const midpoint = Math.floor(requests.length / 2);
      const firstHalfRequests = requests.slice(0, midpoint).reduce((a, b) => a + b, 0);
      const secondHalfRequests = requests.slice(midpoint).reduce((a, b) => a + b, 0);
      const requestsTrend = firstHalfRequests > 0 ? ((secondHalfRequests - firstHalfRequests) / firstHalfRequests * 100).toFixed(1) : 0;

      const firstHalfVisitors = visitors.slice(0, midpoint).reduce((a, b) => a + b, 0);
      const secondHalfVisitors = visitors.slice(midpoint).reduce((a, b) => a + b, 0);
      const visitorsTrend = firstHalfVisitors > 0 ? ((secondHalfVisitors - firstHalfVisitors) / firstHalfVisitors * 100).toFixed(1) : 0;

      // Update trend indicators
      const requestsChangeEl = document.getElementById('requestsChange');
      requestsChangeEl.textContent = `${requestsTrend > 0 ? '↑' : '↓'} ${Math.abs(requestsTrend)}% vs previous period`;
      requestsChangeEl.className = `stat-change ${requestsTrend >= 0 ? 'positive' : 'negative'}`;

      const visitorsChangeEl = document.getElementById('visitorsChange');
      visitorsChangeEl.textContent = `${visitorsTrend > 0 ? '↑' : '↓'} ${Math.abs(visitorsTrend)}% vs previous period`;
      visitorsChangeEl.className = `stat-change ${visitorsTrend >= 0 ? 'positive' : 'negative'}`;

      // Show stats and charts
      document.getElementById('statsGrid').style.display = 'grid';
      document.getElementById('requestsChartSection').style.display = 'block';
      document.getElementById('visitorsChartSection').style.display = 'block';

      // Create/update requests chart
      createOrUpdateChart('requestsChart', 'Requests', dates, requests, 'rgba(61, 78, 233, 0.2)', '#3d4ee9');

      // Create/update visitors chart
      createOrUpdateChart('visitorsChart', 'Unique Visitors', dates, visitors, 'rgba(16, 185, 129, 0.2)', '#10b981');
    }

    // Create or update a chart
    function createOrUpdateChart(canvasId, label, labels, data, backgroundColor, borderColor) {
      const ctx = document.getElementById(canvasId);
      const chartInstance = canvasId === 'requestsChart' ? requestsChart : visitorsChart;

      if (chartInstance) {
        chartInstance.data.labels = labels;
        chartInstance.data.datasets[0].data = data;
        chartInstance.update();
      } else {
        const newChart = new Chart(ctx, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [{
              label: label,
              data: data,
              backgroundColor: backgroundColor,
              borderColor: borderColor,
              borderWidth: 3,
              fill: true,
              tension: 0.4,
              pointRadius: 4,
              pointHoverRadius: 6,
              pointBackgroundColor: borderColor,
              pointBorderColor: '#ffffff',
              pointBorderWidth: 2
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                display: true,
                labels: {
                  color: '#ffffff',
                  font: { size: 12 }
                }
              },
              tooltip: {
                backgroundColor: 'rgba(22, 22, 22, 0.9)',
                titleColor: '#ffffff',
                bodyColor: '#979797',
                borderColor: '#464242',
                borderWidth: 1,
                padding: 12,
                displayColors: false,
                callbacks: {
                  label: function(context) {
                    return `${label}: ${formatNumber(context.parsed.y)}`;
                  }
                }
              }
            },
            scales: {
              x: {
                grid: {
                  color: 'rgba(255, 255, 255, 0.06)',
                  borderColor: '#464242'
                },
                ticks: {
                  color: '#979797',
                  font: { size: 11 },
                  maxRotation: 45,
                  minRotation: 45
                }
              },
              y: {
                grid: {
                  color: 'rgba(255, 255, 255, 0.06)',
                  borderColor: '#464242'
                },
                ticks: {
                  color: '#979797',
                  font: { size: 11 },
                  callback: function(value) {
                    return formatNumber(value);
                  }
                },
                beginAtZero: true
              }
            }
          }
        });

        if (canvasId === 'requestsChart') {
          requestsChart = newChart;
        } else {
          visitorsChart = newChart;
        }
      }
    }

    // Event listeners
    document.getElementById('fetchDataBtn').addEventListener('click', fetchCloudflareAnalytics);
    document.getElementById('saveCredentialsBtn').addEventListener('click', saveCredentials);
    document.getElementById('clearCredentialsBtn').addEventListener('click', clearCredentials);

    // Allow Enter key to fetch data
    document.getElementById('apiToken').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') fetchCloudflareAnalytics();
    });
    document.getElementById('zoneId').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') fetchCloudflareAnalytics();
    });
    document.getElementById('accountId').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') fetchCloudflareAnalytics();
    });

    // Initialize on load
    window.addEventListener('DOMContentLoaded', () => {
      initializeDateInputs();
      loadCredentials();
    });
  </script>
