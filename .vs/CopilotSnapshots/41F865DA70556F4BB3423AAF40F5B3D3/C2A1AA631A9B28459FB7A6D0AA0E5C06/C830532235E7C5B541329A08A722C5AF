## 🌐 Step 5: Update Frontend

### **A. Add API Client to index.html**

Add BEFORE the closing `</body>` tag:

```html
<!-- Search Tracker API Client -->
<script src="search-tracker-api.js"></script>
```

### **B. Replace trackSearch function in index.html**

Find the existing `trackSearch()` function and replace with:

```javascript
async function trackSearch(query) {
  if (!query || query.trim().length === 0) return;

  console.log('🔍 Tracking search:', query);

  // Use API client (handles localStorage + API sync)
  const result = await SearchTrackerAPI.trackSearch(query);

  if (result.success) {
    console.log('✅ Search tracked:', result.source);
  } else {
    console.warn('⚠️ Search tracking failed:', result.error);
  }
}
```

### **C. Update tagcloud.html**

Add the API client script:

```html
<!-- Search Tracker API Client -->
<script src="search-tracker-api.js"></script>
```

Replace `loadTagCloud()` function to use API:

```javascript
async function loadTagCloud() {
  console.log('📊 Loading tag cloud...');

  // Update timestamp
  const now = new Date();
  document.getElementById('lastUpdated').textContent = now.toLocaleTimeString();

  // Fetch from API (auto-fallback to localStorage)
  const result = await SearchTrackerAPI.getUserCloud(50);

  if (!result.success) {
    console.error('❌ Failed to load cloud:', result.error);
    document.getElementById('emptyState').style.display = 'block';
    return;
  }

  const { keywords, recentSearches, totalSearches, uniqueWords } = result.data;
  console.log('✅ Loaded from:', result.source);

  // Render the cloud (existing logic)
  renderTagCloudData(keywords, recentSearches, totalSearches, uniqueWords);
}
```

