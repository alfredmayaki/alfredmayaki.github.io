<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Chat Interface</title>

  <style>
    :root {
      --bg: #0b0b0b;
      --panel: #161616;
      --brand: #3d4ee9;
      --text: #ffffff;
      --muted: #b0b0b0;
      --border: rgba(255,255,255,0.06);
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
    }

    body {
      margin: 0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      display: flex;
      flex-direction: column;
    }

    header {
      padding: 1rem 1.25rem;
      background: linear-gradient(90deg, var(--brand), #5563f0);
      border-bottom: 1px solid var(--border);
    }

    header h1 {
      margin: 0;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    main {
      flex: 1;
      display: flex;
      flex-direction: column;
      max-width: 900px;
      width: 100%;
      margin: 0 auto;
      padding: 1rem;
    }

    .messages {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      overflow-y: auto;
      padding-right: 0.25rem;
    }

    .msg {
      max-width: 85%;
      padding: 0.7rem 0.9rem;
      border-radius: 12px;
      line-height: 1.4;
      word-wrap: break-word;
    }

    .msg.user {
      align-self: flex-end;
      background: linear-gradient(135deg, var(--brand), #5563f0);
      color: #fff;
    }

    .msg.bot {
      align-self: flex-start;
      background: var(--panel);
      border: 1px solid var(--border);
    }

    .composer {
      display: flex;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }

    textarea {
      flex: 1;
      min-height: 56px;
      max-height: 160px;
      resize: vertical;
      padding: 0.7rem 0.85rem;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: #111;
      color: var(--text);
      font-family: inherit;
      font-size: 0.95rem;
    }

    textarea::placeholder {
      color: var(--muted);
    }

    button {
      appearance: none;
      border: none;
      border-radius: 12px;
      padding: 0 1rem;
      font-size: 0.9rem;
      font-weight: 600;
      background: var(--brand);
      color: #fff;
      cursor: pointer;
    }

    button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    footer {
      padding: 0.75rem;
      text-align: center;
      font-size: 0.85rem;
      color: var(--muted);
      border-top: 1px solid var(--border);
    }

    footer a {
      color: inherit;
      text-decoration: underline;
    }
  </style>
</head>

<body>
  <header>
    <h1>ChatGPT — Interactive Prompt</h1>
  </header>

  <main>
    <div class="messages" id="messages" role="log" aria-live="polite"></div>

    <form class="composer" id="chatForm" autocomplete="off">
      <textarea id="promptInput" placeholder="Type your message…"></textarea>
      <button type="submit" id="sendBtn">Send</button>
    </form>
  </main>

  <footer>
    <a href="index.html">Return to site</a>
  </footer>

  <script>
    (() => {
      const form = document.getElementById('chatForm');
      const input = document.getElementById('promptInput');
      const sendBtn = document.getElementById('sendBtn');
      const messages = document.getElementById('messages');

      const escapeHtml = (str = '') =>
        str.replace(/&/g, '&amp;')
           .replace(/</g, '&lt;')
           .replace(/>/g, '&gt;');

      const appendMessage = (text, role) => {
        const div = document.createElement('div');
        div.className = `msg ${role}`;
        div.innerHTML = escapeHtml(text).replace(/\n/g, '<br>');
        messages.appendChild(div);
        messages.scrollTop = messages.scrollHeight;
        return div;
      };

      const setLoading = (state) => {
        sendBtn.disabled = state;
        input.disabled = state;
      };

      const sendPrompt = async (text) => {
        appendMessage(text, 'user');
        const typing = appendMessage('…', 'bot');
        setLoading(true);

        try {
          const res = await fetch('/api/chatgpt', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text })
          });

          let reply = '';
          const ct = (res.headers.get('content-type') || '').toLowerCase();

          if (ct.includes('application/json')) {
            const json = await res.json();
            reply = json.text || json.reply || json.message || JSON.stringify(json);
          } else {
            reply = await res.text();
          }

          typing.remove();

          if (res.ok) {
            appendMessage(reply || 'No response returned.', 'bot');
          } else {
            appendMessage(`Server error (${res.status})`, 'bot');
          }
        } catch (err) {
          typing.remove();
          appendMessage(`Network error: ${err}`, 'bot');
        } finally {
          setLoading(false);
        }
      };

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = input.value.trim();
        if (!text) return;
        input.value = '';
        sendPrompt(text);
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          form.requestSubmit();
        }
      });
    })();
  </script>
</body>
</html>
