    .section-icon {
      font-size: 1.5rem;
      color: var(--brand);
    }

    .section-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text);
    }

    .section-info {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-top: 0.5rem;
    }

