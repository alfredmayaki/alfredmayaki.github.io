    .reference-text {
      color: var(--text);
      line-height: 1.7;
      margin-bottom: 1rem;
      font-size: 0.95rem;
    }

    .reference-authors {
      color: var(--text);
      font-weight: 600;
    }

    .reference-year {
      color: var(--text-secondary);
      font-style: italic;
    }

    .reference-title {
      color: var(--text);
      font-weight: 500;
    }

    .reference-publication {
      color: var(--text-muted);
    }

    .reference-links {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }

    .ref-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: var(--panel);
      color: var(--brand);
