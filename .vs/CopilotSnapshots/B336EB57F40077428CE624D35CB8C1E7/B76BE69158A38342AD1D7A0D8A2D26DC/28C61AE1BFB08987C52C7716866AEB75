/* ---------- Chatbot popup script ---------- */
<script>
(function () {
  const input = document.getElementById('chatbotInput');
  const sendBtn = document.getElementById('chatSend');
  const messages = document.getElementById('chatbotMessages');
  let lastYear = null;
  const CURRENT_YEAR = new Date().getFullYear();

  function ensureYearSeparator(date) {
    const year = date.getFullYear();
    if (year !== lastYear) {
      lastYear = year;
      const sep = document.createElement('div');
      sep.className = 'year-separator';
      sep.textContent = year + (year === CURRENT_YEAR ? ' (this year)' : '');
      messages.appendChild(sep);
    }
  }

  function createMessageEl(text, role, date = new Date()) {
    ensureYearSeparator(date);

    const row = document.createElement('div');
    row.className = 'message ' + (role === 'user' ? 'user' : 'bot');

    // New wrapper for avatar + bubble alignment
    const inner = document.createElement('div');
    inner.className = 'message-row-inner';

    // Avatar
    const avatar = document.createElement('div');
    avatar.className = 'message-avatar';
    avatar.textContent = role === 'user' ? 'You' : 'C';   // C for Claude

    // Bubble container
    const bubble = document.createElement('div');
    bubble.className = 'message-bubble';
    bubble.textContent = text;

    const meta = document.createElement('div');
    meta.className = 'message-meta';

    // Robust time + short date formatting using Intl.DateTimeFormat (works across locales)
    try {
      const timeFormatter = new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit' });
      const dateFormatter = new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric' });
      const time = timeFormatter.format(date);
      const shortDate = dateFormatter.format(date);
      meta.textContent = `${time} • ${shortDate}`;
    } catch (err) {
      // Fallback
      const time = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      const shortDate = date.toLocaleDateString([], { month: 'short', day: 'numeric' });
      meta.textContent = `${time} • ${shortDate}`;
    }

    inner.appendChild(avatar);
    inner.appendChild(bubble);
    row.appendChild(inner);
    row.appendChild(meta);

    return row;
  }

  function scrollToBottom() {
    if (!messages) return;
    messages.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
  }

  async function sendMessage() {
    if (!input) return;
    const text = input.value?.trim();
    if (!text) return;

    const now = new Date();

    // Append user message
    messages.appendChild(createMessageEl(text, 'user', now));
    input.value = '';
    input.focus();
    scrollToBottom();

    // Show temporary bot "typing" indicator
    const typingRow = createMessageEl('...', 'bot', new Date());
    typingRow.querySelector('.message-bubble').classList.add('typing');
    messages.appendChild(typingRow);
    scrollToBottom();

    // Attempt to send to backend API, fallback to simulated reply
    try {
      // Replace /api/chat with your real endpoint if available
      const resp = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text })
      });

      if (!resp.ok) throw new Error('network');

      const json = await resp.json();
      const botText = (json && (json.reply || json.message || json.text)) || 'No reply';
      typingRow.remove();
      messages.appendChild(createMessageEl(botText, 'bot', new Date()));
      scrollToBottom();
    } catch (err) {
      // fallback simulated reply
      setTimeout(() => {
        typingRow.remove();
        messages.appendChild(createMessageEl('Simulated reply — backend not configured.', 'bot', new Date()));
        scrollToBottom();
      }, 700);
    }
  }

  // Bind events
  sendBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    sendMessage();
  });

  input?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  // Minimalist send button handler
  const chatSendBtn = document.getElementById('chatSend');
  chatSendBtn?.addEventListener('click', function (e) {
    e.preventDefault();
    const msg = normalizeUserText(document.getElementById('chatbotInput').value);
    if (!msg) return;
    addUserMessage(msg);
    pushHistory('user', msg);
    void processQuery(msg);
    document.getElementById('chatbotInput').value = '';
    document.getElementById('chatbotInput').focus();
  });

  // Expose a small helper on window for testing / programmatic send (optional)
  window.__chatSendMessage = sendMessage;
})();
</script>
