  <style>
:root {
  --font-sans: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
  --bg-overlay: rgba(22, 22, 22, 0.92);
  --panel: #161616;
  --panel-2: #141414;
  --surface: #2a2a2a;
  --text: #ffffff;
  --text-muted: #979797;
  --text-secondary: #b0b0b0;
  --text-secondary: #b0b0b0;
  --border: #464242;
  --border-soft: rgba(255, 255, 255, 0.06);
  --brand: #3d4ee9;
  --brand-hover: #5563f0;
  --radius-md: 14px;
  --radius-lg: 18px;
  --radius-pill: 999px;
  --shadow-pop: 0 10px 30px rgba(0,0,0,0.6);
  /* intensified brand shadow for focused states */
  --shadow-brand: 0 10px 36px rgba(61,78,233,0.28);
  --transition-fast: 180ms;
  --transition-med: 300ms;
}

/* Intro header (title + image) */
.site-intro {
  display: flex;
  gap: 0.9rem;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
  margin: 0 0 1.25rem;
  padding: 0.4rem 0.6rem;
}
.site-intro img {
  width: 110px;
  height: 110px;
  border-radius: 999px;
  object-fit: cover;
  border: 3px solid rgba(255,255,255,0.06);
  box-shadow: 0 8px 24px rgba(61,78,233,0.08);
}
.site-intro h1 {
  margin: 0;
  font-size: 1.15rem;
  color: var(--text);
  font-weight: 700;
  line-height: 1.1;
}
.site-intro p {
  margin: 0.35rem 0 0;
  color: var(--text-secondary);
  font-size: 0.95rem;
}

/* Page container (index_en look) */
html {
  background: url("/universe.png") center / cover no-repeat fixed;
  background-color: #161616;
  min-height: 100vh;
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-sans);
  background: var(--bg-overlay);
  color: var(--text-muted);
  opacity: 100%;
  line-height: 1.6;
  font-size: 16px;
  max-width: 990px;
  margin: 2em auto;
  padding: 2em;
  padding-bottom: 120px; /* ensure space for fixed footer bar */
  border: 3px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-pop);
  min-height: auto;
}

/* ---------- Top navigation (new) ---------- */
.top-nav {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:1rem;
  max-width: 980px;
  margin: 0  auto 1.25rem;
  padding: 0.45rem 0.6rem;
  background: transparent;
  box-sizing: border-box;
}
.top-nav .brand {
  color: var(--text);
  font-weight: 700;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.98rem;
}
.top-nav .nav-links {
  display:flex;
  gap:0.5rem;
  align-items:center;
  flex-wrap:wrap;
}
.top-nav .nav-links a {
  color: var(--text-secondary);
  text-decoration: none;
  padding: 0.45rem 0.7rem;
  border-radius: 10px;
  font-size: 0.95rem;
  transition: background var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
}
.top-nav .nav-links a:hover,
.top-nav .nav-links a:focus {
  background: rgba(61,78,233,0.08);
  color: var(--text);
  transform: translateY(-2px);
  box-shadow: var(--shadow-brand);
  outline: none;
}
@media (max-width: 600px) {
  .top-nav { flex-direction: column; align-items: flex-start; gap: 0.6rem; padding: 0.4rem; }
  .top-nav .nav-links { width: 100%; justify-content: space-between; }

  .top-nav .brand {
    order: 1;
    margin-bottom: 0.5rem;
    display: flex;
    justify-content: center;
    width: 100%;
  }
}

/* Add into your existing <style> block (near other @media rules). These rules realign the search controls, shrink touch targets, reduce page padding, and ensure the centered report button sits above the chatbot on narrow screens. */
@media (max-width: 600px) {
  /* Make the page less crowded on small screens */
  body {
    margin: 1rem auto;
    padding: 1rem;
    max-width: calc(100% - 2rem);
    border-radius: 12px;
  }

  .search-container {
    display: flex !important;
    flex-direction: column;
    gap: 0.6rem;
    align-items: stretch;
    width: calc(100% - 2rem);
    max-width: none;
    margin: 1rem auto;
    padding: 0.6rem;
  }

  .search-bar {
    order: 0;
    width: 100%;
    padding: 0.85rem 0.9rem;
    font-size: 1rem;
  }

  /* Keep attach + search controls on a single row but aligned to the right */
  .search-controls {
    width: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  /* Make the paperclip label behave like a button for keyboard users */
  label[for="docUploadInput"].attach-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Ensure chatbot popup fits comfortably on small viewports */
  .chatbot-popup {
    right: 12px !important;
    left: 12px !important;
    bottom: 12px !important;
    width: auto !important;
    max-width: none !important;
    max-height: 70vh !important;
    border-radius: 12px !important;
  }

  .chatbot-popup.minimized {
    width: calc(100vw - 24px) !important;
    max-height: 64px !important;
  }
}

/* Mobile: ensure search bar and controls fit with side gaps */
@media (max-width: 600px) {
  .search-container {
    margin: 1rem 16px;         /* 16px gap left/right from viewport edge */
    padding: 0.6rem;          /* internal padding so controls don't touch edges */
    width: auto;
    box-sizing: border-box;
    max-width: calc(100% - 32px);
    border-radius: 12px;
  }

  .search-bar {
    width: 100%;
    min-width: 0;             /* allow flex shrink */
    box-sizing: border-box;
  }

  .search-controls {
    width: 100%;
    display: flex;
    justify-content: flex-end; /* keep buttons aligned and inside padded area */
