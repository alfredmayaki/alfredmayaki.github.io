  <script>
    // Initialize Firebase
    let firebaseInitialized = false;
    if (window.FirebaseSearchTracking) {
      firebaseInitialized = window.FirebaseSearchTracking.initFirebase();
    }

    // Track search queries for tag cloud (now using API client)
    async function trackSearch(query) {
      if (!query || query.trim().length === 0) return;

      console.log('🔍 Tracking search:', query);

      // Use API client (handles localStorage + API sync)
      const result = await SearchTrackerAPI.trackSearch(query);

      if (result.success) {
        console.log('✅ Search tracked:', result.source);
      } else {
        console.warn('⚠️ Search tracking failed:', result.error);
      }

      // Still track in Firebase if available (for backward compatibility)
      if (firebaseInitialized && window.FirebaseSearchTracking) {
        const stopWords = ['the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of', 'with', 'is', 'was', 'are', 'be', 'have', 'has', 'what', 'when', 'where', 'why', 'how', 'can', 'could', 'would', 'should', 'will'];
        const words = query.toLowerCase()
          .replace(/[^\w\s]/g, ' ')
          .split(/\s+/)
          .filter(word => word.length > 2 && !stopWords.includes(word));

        const keywords = {};
        words.forEach(word => {
          keywords[word] = (keywords[word] || 0) + 1;
        });

        window.FirebaseSearchTracking.trackSearchFirebase(query.trim(), keywords)
          .catch(error => console.warn('Firebase tracking failed:', error));
      }
    }

      // Attach to search button and Enter key
      document.getElementById('searchBtn')?.addEventListener('click', function() {
        const query = document.getElementById('searchInput')?.value;
        if (query) {
          console.log('🔍 Search triggered:', query);
          trackSearch(query);
          console.log('✅ trackSearch() called');
        }
      });

      document.getElementById('searchInput')?.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          const query = this.value;
          if (query) {
            console.log('🔍 Search triggered (Enter):', query);
            trackSearch(query);
            console.log('✅ trackSearch() called');
          }
        }
      });

      // DEBUG: Check tracking status after 2 seconds
      setTimeout(() => {
        console.log('=== SEARCH TRACKING DEBUG===');
        console.log('Firebase initialized:', firebaseInitialized);
        console.log('FirebaseSearchTracking exists:', typeof window.FirebaseSearchTracking !== 'undefined');
        console.log('LocalStorage searches:', localStorage.getItem('claudeSearches'));
        console.log('LocalStorage timestamps:', localStorage.getItem('claudeSearchTimestamps'));
        console.log('================================');
