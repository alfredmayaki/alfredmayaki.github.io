<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>ChatGPT — Prompt</title>
  <style>
    :root{--bg:#0b0b0b;--panel:#161616;--brand:#3d4ee9;--text:#fff;--muted:#b0b0b0}
    body{margin:0;font-family:Segoe UI, system-ui, -apple-system, Arial, sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;flex-direction:column}
    header{padding:1rem;border-bottom:1px solid rgba(255,255,255,0.04);background:linear-gradient(90deg,var(--brand),#5563f0)}
    header h1{margin:0;font-size:1rem}
    .container{max-width:900px;margin:1.25rem auto;padding:1rem;width:calc(100% - 2rem)}
    .controls{display:flex;gap:0.5rem;align-items:center}
    textarea{flex:1;min-height:72px;padding:0.8rem;border-radius:12px;border:1px solid rgba(255,255,255,0.04);background:#111;color:var(--text);resize:vertical}
    button{background:var(--brand);color:#fff;border:none;padding:0.65rem 0.9rem;border-radius:10px;cursor:pointer}
    .messages{margin-top:1rem;display:flex;flex-direction:column;gap:0.9rem}
    .msg{max-width:86%;padding:0.7rem 0.9rem;border-radius:12px;line-height:1.35}
    .msg.user{align-self:flex-end;background:linear-gradient(135deg,var(--brand),#5563f0);color:#fff}
    .msg.bot{align-self:flex-start;background:#1c1c1c;border:1px solid rgba(255,255,255,0.03);color:var(--text)}
    .meta{font-size:0.85rem;color:var(--muted);margin-top:0.4rem;text-align:right}
    footer{margin-top:auto;padding:1rem;text-align:center;color:var(--muted);font-size:0.9rem}
    a.link{color:inherit;text-decoration:underline}
  </style>
</head>
<body>
  <header>
    <h1>ChatGPT — Interactive Prompt</h1>
  </header>
  <main class="container">
    <div class="controls" role="region" aria-label="Prompt controls">
      <textarea id="promptInput" placeholder="Enter your prompt here..."></textarea>
      <button id="sendBtn">Send</button>
    </div>

    <div class="messages" id="messages" role="log" aria-live="polite"></div>
  </main>

  <footer>
    <a href="index.html" class="link">Return to site</a>
  </footer>

  <script>
    (function(){
      const input = document.getElementById('promptInput');
      const sendBtn = document.getElementById('sendBtn');
      const messages = document.getElementById('messages');

      function escapeHtml(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

      function appendMsg(text, cls){
        const el = document.createElement('div');
        el.className = 'msg ' + cls;
        el.innerHTML = escapeHtml(text).replace(/\n/g,'<br>');
        messages.appendChild(el);
        messages.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
      }

      function setLoading(loading){ sendBtn.disabled = loading; input.disabled = loading; }

      async function sendPrompt(){
        const text = input.value.trim();
        if(!text) return;
        appendMsg(text, 'user');
        input.value = '';
        setLoading(true);
        const typing = document.createElement('div'); typing.className='msg bot'; typing.textContent='...'; messages.appendChild(typing);
        try{
          const resp = await fetch('/api/chatgpt', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ message: text }) });
          const json = await resp.json();
          typing.remove();
          if(resp.ok && json && json.text){ appendMsg(json.text, 'bot'); }
          else { appendMsg('No reply or error from server.', 'bot'); }
        }catch(err){ typing.remove(); appendMsg('Network error: ' + String(err), 'bot'); }
        finally{ setLoading(false); }
      }

      sendBtn.addEventListener('click', (e)=>{ e.preventDefault(); void sendPrompt(); });
      input.addEventListener('keydown', (e)=>{ if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); void sendPrompt(); } });

      // Prefill from ?q= param if present
      try{
        const params = new URLSearchParams(window.location.search);
        const q = params.get('q'); if(q){ input.value = q; input.focus(); }
      }catch(e){}
    })();
  </script>
</body>
</html>