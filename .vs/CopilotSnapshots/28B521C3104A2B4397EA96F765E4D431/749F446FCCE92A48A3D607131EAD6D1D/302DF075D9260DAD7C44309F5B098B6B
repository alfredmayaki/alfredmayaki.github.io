<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login to AM-Global</title>

  <!-- Particles.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/particles.js/2.0.0/particles.min.js"></script>
  <!-- Google Identity Services (native Google button) -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>

  <style>
    :root {
      --font-sans: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;

      --bg-overlay: rgba(22, 22, 22, 0.92);
      --panel: #161616;
      --panel-2: #141414;
      --surface: #2a2a2a;

      --text: #ffffff;
      --text-muted: #979797;

      --border: #464242;
      --border-soft: rgba(255, 255, 255, 0.06);

      --brand: #3d4ee9;
      --brand-hover: #5563f0;

      --radius-sm: 10px;
      --radius-md: 14px;
      --radius-lg: 16px;
      --radius-pill: 999px;

      --shadow-pop: 0 14px 40px rgba(0, 0, 0, 0.55);
      --shadow-brand: 0 6px 16px rgba(61, 78, 233, 0.35);
    }

    /* Make sizing predictable so form controls fit their containers */
    *, *::before, *::after {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: var(--font-sans);
      color: var(--text-muted);
      background: url("/universe.png") center / cover no-repeat fixed;
      position: relative;
    }

    #particles-js {
      position: fixed;
      top: 0; left: 0;
      width: 100vw;
      height: 100vh;
      z-index: -1;
    }

    .landing-container {
      width: 100%;
      max-width: 900px;
      min-height: 100vh;
      margin: 1em auto;
      padding: 2em 4em 6em;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      background: #000000; /* jet black */
      border: 1px solid var(--border);
      border-radius: 12px;
      animation: fadeIn 0.9s ease-in;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .main-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .profile-photo {
      width: 180px;
      height: 180px;
      border-radius: 50%;
      border: 5px solid var(--text-muted);
      object-fit: cover;
      margin-bottom: 2em;
      box-shadow: var(--shadow-pop);
    }

    h1 {
      margin: 0 0 0.3em;
      font-size: 2.5em;
      color: var(--text);
    }

    .tagline {
      margin: 0 0 2em;
      font-size: 1.2em;
      color: var(--text-muted);
    }

    .intro {
      max-width: 700px;
      margin: 0 auto 2.5rem;
      color: var(--text-muted);
      font-size: 1.1em;
      line-height: 1.7;
      /* Override parent centering and justify paragraph text for readability */
      text-align: justify;
      text-justify: inter-word;
      /* Keep the last line left-aligned (prevents awkward centered last lines) */
      text-align-last: left;
    }

    /* Be explicit for paragraph elements inside .intro */
    .intro p {
      margin-left: 0;
      margin-right: 0;
      text-align: justify;
      text-justify: inter-word;
      text-align-last: left;
    }

    .section-hidden { display: none !important; }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.8rem;
      margin-bottom: 1.8rem;
      width: 100%;
      max-width: 800px;
      box-shadow: var(--shadow-pop);
    }

    label {
      display: block;
      font-weight: 600;
      margin-bottom: 0.8rem;
      color: var(--text);
    }

    /* Ensure textareas fit inside .card (account for padding + borders) */
    textarea {
      display: block;
      width: 100%;
      max-width: 100%;
      min-height: 130px;
      padding: 1rem;
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      color: var(--text);
      font-size: 1rem;
      resize: vertical;
      box-sizing: border-box; /* explicit for older browsers */
    }

    textarea:focus {
      outline: none;
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(61, 78, 233, 0.2);
    }

    .subquestion {
      margin-top: 1.5rem;
      padding-left: 1.5rem;
      border-left: 4px solid var(--brand);
    }

    .btn {
      padding: 0.9rem 1.8rem;
      font-size: 1.05rem;
      font-weight: 500;
      border: none;
      border-radius: var(--radius-pill);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: var(--brand);
      color: white;
    }

    .btn-primary:hover {
      background: var(--brand-hover);
      box-shadow: var(--shadow-brand);
      transform: translateY(-2px);
    }

    .btn-danger {
      background: #dc3545;
      color: white;
    }

    .btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .center-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      margin: 2rem 0;
      align-items: center;
    }

    #status {
      color: #28a745;
      font-weight: 600;
      text-align: center;
      margin: 1.5rem 0;
      font-size: 1.1em;
    }

    #error {
      color: #ff4444;
      font-weight: 500;
      text-align: center;
      margin: 1.2rem 0;
    }

    /* Footer – centered like your main site */
    .site-footer {
      width: 100%;
      padding: 2em 0;
      border-top: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.9em;
      text-align: center;
    }

    .footer-links {
      display: flex;
      gap: 2em;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 1em;
    }

    .footer-link {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .footer-link:hover {
      color: var(--brand);
      text-decoration: underline;
    }

    .footer-copyright {
      color: var(--text-muted);
      font-size: 0.85em;
    }

    .intro-note {
      text-align: center;
      margin: 0.75rem 0 0;
      color: var(--text-muted);
    }

    .intro-note em {
      display: block;
      margin-top: 0.25rem;
      font-style: italic;
      color: var(--text-muted);
    }

    /* New wrapper for login section to contain and optionally style it */
    .login-container {
      width: 100%;
      max-width: 820px;
      margin: 0 auto 1.5rem;
      padding: 0 12px;
    }

    /* Grid Layout for Intro Content */
    .container-grid {
      display: grid;
      gap: 1rem;
      align-items: start;
      width: 100%;
    }
    .container-grid__item p {
      margin: 0;
      line-height: 1.7;
      color: var(--text-muted);
      text-align: justify;
      text-justify: inter-word;
    }
    /* keep separators visually subtle if you choose to keep the comments/hrs */
    .container-grid__item + .container-grid__item { padding-top: 0.25rem; }
    @media (min-width: 900px) {
      .container-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

  <!-- Firebase SDK -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";
    import { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged, getIdToken, signInWithCredential } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js";
    import { getFirestore, doc, setDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "AIzaSyD0IQolC1QyP-RV0QWdJQ7MteXl5axb1go",
      authDomain: "supa-73a39.firebaseapp.com",
      projectId: "supa-73a39",
      storageBucket: "supa-73a39.firebasestorage.app",
      messagingSenderId: "447556072560",
      appId: "1:447556072560:web:0857492edd4898abf470b5"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);
    const provider = new GoogleAuthProvider();
    provider.setCustomParameters({ prompt: 'select_account' });

    const loginSection = document.getElementById('login-section');
    const surveySection = document.getElementById('survey-section');
    const logoutBtn = document.getElementById('logout-button');
    const submitBtn = document.getElementById('submit-button');
    const form = document.getElementById('survey-form');
    const statusEl = document.getElementById('status');
    const errorEl = document.getElementById('error');
    const googleStatusEl = document.getElementById('google-login-status');

    // Legacy popup sign-in (kept as fallback)
    // Sign-in with popup is still available when needed:
    // await signInWithPopup(auth, provider);

    logoutBtn?.addEventListener('click', () => signOut(auth));

    // onAuthStateChanged will update UI and reveal the hidden survey on successful login.
    onAuthStateChanged(auth, async (user) => {
      if (user) {
        // Show survey UI (hidden behind login)
        if (googleStatusEl) googleStatusEl.textContent = `Signed in as ${user.email || user.displayName || 'user'}`;
        if (loginSection) loginSection.classList.add('section-hidden');
        if (surveySection) surveySection.classList.remove('section-hidden');
        if (submitBtn) submitBtn.disabled = false;

        // Send token to backend asynchronously (fire-and-forget).
        try {
          const idToken = await getIdToken(user, /* forceRefresh= */ false);
          fetch('/sessionLogin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ idToken })
          }).then(resp => {
            if (!resp.ok) {
              console.warn('sessionLogin responded with non-OK status', resp.status);
            }
          }).catch(err => {
            console.error('sessionLogin network error', err);
          });
        } catch (err) {
          console.error('Could not get ID token for sessionLogin:', err);
        }
      } else {
        // Not signed in — show login UI and hide survey
        if (loginSection) loginSection.classList.remove('section-hidden');
        if (surveySection) surveySection.classList.add('section-hidden');
        if (submitBtn) submitBtn.disabled = true;
        if (form) form.reset();
        if (googleStatusEl) googleStatusEl.textContent = 'Not signed in';
      }
    });

    form.addEventListener('submit', async e => {
      e.preventDefault();
      if (!auth.currentUser || !form.q1.value.trim()) {
        if (errorEl) errorEl.textContent = !auth.currentUser ? "Please sign in." : "Please answer question 1.";
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Submitting…";

      const data = {
        q1: form.q1.value, q2: form.q2.value, q2a: form.q2a.value,
        q3: form.q3.value, q3a: form.q3a.value, q4: form.q4.value, q4a: form.q4a.value,
        q5: form.q5.value, q6: form.q6.value, q6a: form.q6a.value, q7: form.q7.value,
        userId: auth.currentUser.uid,
        submittedAt: serverTimestamp()
      };

      try {
        await setDoc(doc(db, "surveyResponses", auth.currentUser.uid), data);
        if (statusEl) statusEl.textContent = "Thank you! Your responses have been successfully submitted.";
        form.reset();
        submitBtn.textContent = "Submitted";
        submitBtn.disabled = true;
      } catch (err) {
        console.error('Submission error', err);
        if (errorEl) errorEl.textContent = err.code === 'permission-denied'
          ? "You have already submitted a response with this account. Thank you!"
          : "Submission failed. Please try again.";
        submitBtn.disabled = false;
        submitBtn.textContent = "Submit Survey";
      }
    });

    // Google Identity Services integration
    const GOOGLE_CLIENT_ID = '447556072560-9fn2v4pq58bahht7b1d4khgltk6ja8p0.apps.googleusercontent.com';

    // Handler invoked by the Google Identity callback
    window.handleGoogleCredentialResponse = async function (response) {
      // response.credential is the ID token (JWT)
      if (!response || !response.credential) {
        console.warn('No credential returned from Google Identity.');
        return;
      }
      try {
        // Sign in to Firebase using the ID token obtained from Google Identity Services
        const idToken = response.credential;
        const credential = GoogleAuthProvider.credential(idToken);
        await signInWithCredential(auth, credential); // modular sign-in
        // onAuthStateChanged will run and reveal the survey
      } catch (err) {
        console.error('Error signing in with Google credential:', err);
        if (errorEl) errorEl.textContent = "Google sign-in failed. Please try the popup fallback or enable cookies.";
      }
    };

    // Initialize Google Identity button after the GIS script is loaded
    function initGoogleButton() {
      if (!window.google || !google.accounts || !google.accounts.id) {
        console.warn('Google Identity Services not available yet.');
        return;
      }
      google.accounts.id.initialize({
        client_id: GOOGLE_CLIENT_ID,
        callback: handleGoogleCredentialResponse,
        // auto_select: false // don't auto sign-in unless desired
      });

      // Render the "Sign in with Google" button into the placeholder
      google.accounts.id.renderButton(
        document.getElementById('g_id_signin'),
        { theme: 'outline', size: 'large', text: 'signin_with' } // customization
      );

      // Optional: don't auto prompt; leave user to click the button
      google.accounts.id.prompt(); // can be removed if you don't want prompt behavior
    }

    // Wait for GIS to load, then init the button
    window.addEventListener('load', function () {
      // Give GIS a short time to load; if you prefer, poll for google.accounts.id
      setTimeout(initGoogleButton, 250);
    });
  </script>

  <!-- Particles.js Config -->
  <script>
    particlesJS("particles-js", {
      particles: {
        number: { value: 80, density: { enable: true, value_area: 800 } },
        color: { value: "#ffffff" },
        shape: { type: "circle" },
        opacity: { value: 0.5, random: true },
        size: { value: 3, random: true },
        line_linked: { enable: true, distance: 150, color: "#ffffff", opacity: 0.2, width: 1 },
        move: { enable: true, speed: 2, direction: "none", random: false, straight: false, out_mode: "out" }
      },
      interactivity: {
        detect_on: "canvas",
        events: { onhover: { enable: true, mode: "repulse" }, onclick: { enable: true, mode: "push" }, resize: true }
      },
      retina_detect: true
    });
  </script>
</body>
</html>