  <!-- Strong, specific rules to ensure the chatbot popup never shows a horizontal scrollbar
       Applied here to override any environment differences between test and production. -->
  <style>
    /* make sure popup and its message area never overflow horizontally */
    .chatbot-popup, #chatbotPopup, .chatbot-messages {
      overflow-x: hidden !important;
      -ms-overflow-style: none !important; /* IE/Edge */
      scrollbar-width: none !important; /* Firefox */
    }

    /* hide webkit scrollbars inside the popup/messages */
    .chatbot-popup::-webkit-scrollbar,
    #chatbotPopup::-webkit-scrollbar,
    .chatbot-messages::-webkit-scrollbar,
    .chatbot-messages *::-webkit-scrollbar {
      display: none !important;
      width: 0 !important;
      height: 0 !important;
