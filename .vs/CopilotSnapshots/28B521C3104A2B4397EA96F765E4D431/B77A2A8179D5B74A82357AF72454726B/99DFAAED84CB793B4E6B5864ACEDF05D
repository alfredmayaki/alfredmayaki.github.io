  (function () {
  const fileInput = document.getElementById('docUploadInput');
  const uploadBtn = document.getElementById('docUploadBtn');
  const uploadList = document.getElementById('uploadList');

  if (!fileInput || !uploadBtn) return;

  // Ensure global storage exists (defensive)
  window.uploadedDocs = window.uploadedDocs || [];

  // Open native picker on click / keyboard activation
  uploadBtn.addEventListener('click', () => fileInput.click());
  uploadBtn.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });

  // Lightweight, robust handler that tolerates missing helpers in production
  fileInput.addEventListener('change', async (e) => {
    const files = Array.from(e.target.files || []);
    if (!files.length) return;

    for (const f of files) {
      // Try to show a quick UI hint only if helper exists
      try {
        if (typeof pushChatMessage === 'function') {
          pushChatMessage(`Uploading ${f.name}…`, 'user');
        }
      } catch (err) {
        console.warn('pushChatMessage not available:', err);
      }

      // Try to extract locally if helper exists, otherwise fall back to a minimal placeholder.
      let result = null;
      try {
        if (typeof extractFile === 'function') {
          result = await extractFile(f);
        } else {
          // Fallback: create a minimal result object so other code can rely on structure
          result = { name: f.name, text: '', filename: f.name, source: 'client-fallback' };
        }
      } catch (err) {
        console.warn('extractFile failed or not present:', err);
        result = { name: f.name, text: '', filename: f.name, source: 'client-error' };
      }

      try {
        // Ensure global list exists and push the extraction/result
        window.uploadedDocs = window.uploadedDocs || [];
        window.uploadedDocs.push(result);
      } catch (err) {
        console.warn('Failed to push to window.uploadedDocs:', err);
      }

      try {
        if (typeof pushChatMessage === 'function') {
          pushChatMessage(`Document received: ${f.name}`, 'bot');
        }
      } catch (err) {
        /* ignore */
      }

      // Always attach the raw File to the chatbot state if the helper is available.
      // This ensures the very next search will be sent with the file even if extraction helpers are missing.
      try {
        if (typeof window.__setUploadedFile === 'function') {
          window.__setUploadedFile(f);   // set state.uploadedFile inside index.js
        } else {
          // As an additional defensive step, store the raw File locally so other scripts can pick it up.
