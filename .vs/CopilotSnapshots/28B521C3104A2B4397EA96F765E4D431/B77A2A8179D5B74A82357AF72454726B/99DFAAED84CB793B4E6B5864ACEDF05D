/* ---------- Chatbot popup script ---------- */
<script>
document.addEventListener('DOMContentLoaded', function () {
  // GPT button integration: non-streaming proxy to server /api/gpt
  async function callServerGpt(prompt) {
    console.log('[gpt] callServerGpt called', { prompt: prompt && String(prompt).slice(0,80) });
    try {
      // OpenAI /api/gpt proxy is used for GPT requests
      const resp = await fetch('/api/gpt', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ model: 'gpt-5.2', prompt })
      });
      if (!resp.ok) {
        const txt = await resp.text().catch(() => '');
        console.warn('[gpt] /api/gpt non-ok', resp.status, txt);
        throw new Error('network');
      }
      let json = null;
      try { json = await resp.json(); } catch (e) { json = null; console.warn('[gpt] failed to parse /api/gpt json', e); }
      if (!json) json = {};
      // Normalize reply/timestamp fields so callers can rely on them
      json.reply = String(json.reply || json.text || json.message || '').trim();
      if (!json.timestamp) json.timestamp = new Date().toISOString();
      console.log('[gpt] /api/gpt response', { replyPreview: json.reply.slice(0,80), timestamp: json.timestamp });
      return json;
    } catch (err) {
      console.warn('[gpt] GPT proxy error', err);
      return { reply: 'Simulated reply — GPT endpoint not reachable.' };
    }
  }

  function formatTimeOnly(date) {
    try {
      return new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(date);
    } catch (e) {
      return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
  }

  function appendChatMessage(text, role='bot', containerId = 'chatbotMessages') {
    const messages = document.getElementById(containerId);
    if (!messages) return null;
    const row = document.createElement('div');
    row.className = 'message ' + (role === 'user' ? 'user' : 'bot');

    const inner = document.createElement('div');
    inner.className = 'message-row-inner';

    const bubble = document.createElement('div');
    bubble.className = 'message-bubble';
    bubble.textContent = text;

    const meta = document.createElement('div');
    meta.className = 'message-meta';
    // Include a generic author label for user messages and a time-only meta for bots
    if (role === 'user') {
      meta.innerHTML = `<span class="message-author">You</span> ${formatTimeOnly(new Date())}`;
    } else {
      meta.textContent = formatTimeOnly(new Date());
    }

    inner.appendChild(bubble);
    row.appendChild(inner);
    row.appendChild(meta);
    messages.appendChild(row);
    try {
      if (typeof messages.scrollTo === 'function') messages.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
      else messages.scrollTop = messages.scrollHeight;
    } catch (e) {
      try { messages.scrollTop = messages.scrollHeight; } catch (e) { /* ignore */ }
    }
    return row;
  }

  // Centralized helper to send a prompt to GPT popup
  window.__sendPromptToGpt = async function (prompt) {
    if (!prompt || !String(prompt).trim()) return;
    prompt = String(prompt).trim();
    console.log('[gpt popup] __sendPromptToGpt start', { preview: prompt.slice(0,80) });

    // open GPT popup (separate read-only responses)
    const gptPopup = document.getElementById('gptPopup');
    if (gptPopup) {
      gptPopup.classList.add('active');
      gptPopup.classList.remove('minimized');
      try { gptPopup.setAttribute('aria-hidden', 'false'); } catch (e) {}
    }

    // append user message into GPT messages area (robust: create fallback if container missing)
    const userRow = appendChatMessage('💬 ' + prompt, 'user', 'gptMessages');
    if (!userRow) {
      try {
        const messages = document.getElementById('gptMessages');
        if (messages) {
          const row = document.createElement('div');
          row.className = 'message user';
          row.innerHTML = `<div class="message-row-inner"><div class="message-bubble">💬 ${escapeHtml(prompt)}</div></div><div class="message-meta">${formatTimeOnly(new Date())}</div>`;
          messages.appendChild(row);
          scrollToBottom();
        }
      } catch (e) { console.warn('[gpt popup] fallback user append failed', e); }
    }

    // disable button while request is in-flight and show typing placeholder
    const btn = document.getElementById('gptNewBtn');
    if (btn) { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); btn.setAttribute('aria-pressed', 'true'); }
    const typing = appendChatMessage('Thinking...', 'bot', 'gptMessages');

    let result;
    try {
      result = await callServerGpt(prompt);
    } catch (err) {
      result = { reply: 'Simulated reply — GPT endpoint not reachable.' };
    }

    // remove typing placeholder
    try { if (typing && typing.remove) typing.remove(); } catch (err) { console.warn('[gpt popup] failed to remove typing placeholder', err); }

    const reply = String(result?.reply || result?.text || result?.message || '(empty reply)');
    // If server returned timestamp or source, include them in the meta
    const row = appendChatMessage(reply, 'bot', 'gptMessages');
    if (!row) console.warn('[gpt popup] failed to append reply to gptMessages container', { replyPreview: reply.slice(0,80) });
    console.log('[gpt popup] reply appended', { preview: reply.slice(0,80) });
    try {
      const meta = row && row.querySelector && row.querySelector('.message-meta');
      if (meta) {
        const ts = result?.timestamp ? new Date(result.timestamp) : new Date();
        meta.innerHTML = `<span class="message-source">OpenAI</span> ${formatTimeOnly(ts)}`;
      }
    } catch (e) { /* ignore */ }

    if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); btn.removeAttribute('aria-pressed'); }
  };

  // small helper to escape text used inside innerHTML fallbacks
  function escapeHtml(s) {
    return String(s).replace(/[&<>\"]/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; });
  }

  // Click handler for GPT button delegates to centralized helper and records last target
  // GPT button was removed from the search controls; no direct DOM binding is needed here.
  
  // expose helpers for other scripts
  window.appendChatMessage = appendChatMessage;
  window.__openChatbot = function () {
    const chatbotPopup = document.getElementById('chatbotPopup');
    if (chatbotPopup) {
      chatbotPopup.classList.add('active');
      chatbotPopup.classList.remove('minimized');
      setTimeout(() => document.getElementById('chatbotInput')?.focus(), 120);
    }
  };

  // append a clickable link for a search term inside the chat
  window.appendChatLink = function (query, role = 'user') {
    const messages = document.getElementById('chatbotMessages');
    if (!messages) return null;
    const row = document.createElement('div');
    row.className = 'message ' + (role === 'user' ? 'user' : 'bot');

    const inner = document.createElement('div');
    inner.className = 'message-row-inner';

    const bubble = document.createElement('div');
    bubble.className = 'message-bubble';

    const a = document.createElement('a');
    a.href = '#';
    a.textContent = query;
    a.style.color = 'var(--brand)';
    a.style.textDecoration = 'underline';
    a.addEventListener('click', function (ev) {
      ev.preventDefault();
      // When clicked, populate the search input and retrigger trackSearch
      const si = document.getElementById('searchInput');
      if (si) si.value = query;
      if (typeof trackSearch === 'function') trackSearch(query);
      // Also focus the chat input for follow-up
      const chatInput = document.getElementById('chatbotInput');
      if (chatInput) chatInput.focus();
    });

    bubble.appendChild(a);

    const meta = document.createElement('div');
    meta.className = 'message-meta';
    meta.textContent = formatTimeOnly(new Date());

    inner.appendChild(bubble);
    row.appendChild(inner);
    row.appendChild(meta);
    messages.appendChild(row);
    messages.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
    return row;
  };

})();
</script>
<script>
(function () {
  const input = document.getElementById('chatbotInput');
  const sendBtn = document.getElementById('chatSend');
  const messages = document.getElementById('chatbotMessages');
  let lastYear = null;
  const CURRENT_YEAR = new Date().getFullYear();

  function ensureYearSeparator(date) {
    const year = date.getFullYear();
    if (year !== lastYear) {
      lastYear = year;
      const sep = document.createElement('div');
      sep.className = 'year-separator';
      sep.textContent = year + (year === CURRENT_YEAR ? ' (this year)' : '');
      messages.appendChild(sep);
    }
  }

  function createMessageEl(text, role, date = new Date()) {
    ensureYearSeparator(date);

    const row = document.createElement('div');
    row.className = 'message ' + (role === 'user' ? 'user' : 'bot');

    // New wrapper for avatar + bubble alignment
    const inner = document.createElement('div');
    inner.className = 'message-row-inner';

    // Avatar
    const avatar = document.createElement('div');
    avatar.className = 'message-avatar';
    if (role === 'user') {
      // user profile placeholder image (keeps consistent sizing)
      const img = document.createElement('img');
      img.className = 'avatar-img';
      img.alt = 'You';
      // primary src is site root image; if missing, fallback to a tiny SVG avatar so UI still shows
      img.src = '/default.jpg';
      img.onerror = function () {
        try {
          this.onerror = null;
          this.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64"><rect width="100%" height="100%" fill="%232a2a2a"/><text x="50%" y="50%" dy=".35em" fill="%23ffffff" font-family="Segoe UI, Arial, sans-serif" font-size="28" text-anchor="middle">U</text></svg>';
        } catch (e) {
          // as a last resort, show nothing
          this.style.display = 'none';
        }
      };
      avatar.appendChild(img);
    } else {
      // bot initial
      avatar.textContent = 'C';   // C for Claude / chatbot
    }

    // Bubble container
    const bubble = document.createElement('div');
    bubble.className = 'message-bubble';
    // Prepend chat emoji for user-originated prompts
    bubble.textContent = (role === 'user') ? `💬 ${text}` : text;

    const meta = document.createElement('div');
    meta.className = 'message-meta';

    // Show time-only (include seconds) in the message meta and include
    // a generic author label for user messages.
    try {
      const timeFormatter = new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      const time = timeFormatter.format(date);
      if (role === 'user') {
        meta.innerHTML = `<span class="message-author">You</span> ${time}`;
      } else {
        meta.textContent = time;
      }
    } catch (err) {
      // Fallback: locale-aware time with seconds
      const fallback = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      if (role === 'user') meta.innerHTML = `<span class="message-author">You</span> ${fallback}`;
      else meta.textContent = fallback;
    }

    inner.appendChild(avatar);
    inner.appendChild(bubble);
    row.appendChild(inner);
    row.appendChild(meta);

    return row;
  }

  function scrollToBottom() {
    if (!messages) return;
    messages.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
  }

  async function sendMessage() {
    if (!input) return;
    const text = input.value?.trim();
    if (!text) return;

    const now = new Date();
    // Determine routing: GPT (OpenAI) vs Claude (Anthropic)
    const isGpt = window.__lastChatTarget === 'gpt';

    if (isGpt) {
      // GPT flow: show user message, show typing, call /api/gpt and label reply OpenAI
      messages.appendChild(createMessageEl(text, 'user', now));
      input.value = '';
      input.focus();
      scrollToBottom();

      const typingRow = createMessageEl('🧑🏿‍💻💭 Thinking...', 'bot', new Date());
      typingRow?.querySelector('.message-bubble')?.classList.add('typing');
      messages.appendChild(typingRow);
      scrollToBottom();

      try {
        const json = await callServerGpt(text);
        const botText = String(json?.reply || json?.text || json?.message || '(empty reply)');
        try { typingRow.remove(); } catch (e) {}

        const ts = json?.timestamp ? new Date(json.timestamp) : new Date();
        const botRow = createMessageEl(botText, 'bot', ts);
        // set provider label + timestamp
        try {
          const meta = botRow.querySelector('.message-meta');
          if (meta) {
            meta.innerHTML = `<span class="message-source">OpenAI</span> ${formatTimeOnly(ts)}`;
          }
        } catch (e) {}

        messages.appendChild(botRow);
        scrollToBottom();
      } catch (err) {
        try { typingRow.remove(); } catch (e) {}
        messages.appendChild(createMessageEl('Simulated reply — GPT backend not reachable.', 'bot', new Date()));
        scrollToBottom();
      }
    } else {
      // Claude flow: delegate to the main processQuery path which handles files/history
      // Ensure the chatbot UI shows the user message before the backend reply
      // Use the shared helpers if available
      try {
        if (typeof addUserMessage === 'function') addUserMessage(text); else messages.appendChild(createMessageEl(text, 'user', now));
        if (typeof pushHistory === 'function') pushHistory('user', text);
        input.value = '';
        input.focus();
        scrollToBottom();

        // Call existing processQuery if available (posts to configured Claude/chat endpoint)
        if (typeof processQuery === 'function') {
          void processQuery(text);
        } else {
          // Fallback: call the site's generic chat endpoint and append reply
          const typingRow = createMessageEl('🧑🏿‍💻💭 Thinking...', 'bot', new Date());
          typingRow?.querySelector('.message-bubble')?.classList.add('typing');
          messages.appendChild(typingRow);
          scrollToBottom();

          try {
            const resp = await fetch('https://alfredmayaki.me/chat', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ message: text, stream: false, history: [] })
            });
            const json = await resp.json().catch(() => null);
            try { typingRow.remove(); } catch (e) {}
            const botText = String(json?.reply || json?.text || json?.message || '(empty reply)');
            const ts = json?.timestamp ? new Date(json.timestamp) : new Date();
            const botRow = createMessageEl(botText, 'bot', ts);
            try {
              const meta = botRow.querySelector('.message-meta');
            if (meta) meta.innerHTML = `<span class="message-source">Claude</span> ${formatMessageTime(ts)}`;
            } catch (e) {}
            messages.appendChild(botRow);
            scrollToBottom();
          } catch (err) {
            try { typingRow.remove(); } catch (e) {}
            messages.appendChild(createMessageEl('Simulated reply — chat backend not reachable.', 'bot', new Date()));
            scrollToBottom();
          }
        }
      } catch (e) {
        console.warn('Error in Claude send flow', e);
      }
    }
  }

  // Rely on index.js to bind chat send events to #chatSend and chatbot input.
  // This avoids duplicate bindings and centralizes routing logic.

  // Minimalist send button handler
  const chatSendBtn = document.getElementById('chatSend');
  chatSendBtn?.addEventListener('click', function (e) {
    e.preventDefault();
    const msg = normalizeUserText(document.getElementById('chatbotInput').value);
    if (!msg) return;
    addUserMessage(msg);
    pushHistory('user', msg);
    void processQuery(msg);
    document.getElementById('chatbotInput').value = '';
    document.getElementById('chatbotInput').focus();
  });

  // Expose a small helper on window for testing / programmatic send (optional)
  window.__chatSendMessage = sendMessage;
});
</script>
