/* ---------- Search bar (integrated and smooth) ---------- */
.search-container {
  width: 100%;
  max-width: 650px;
  margin: 2em auto;
  display: flex;
  gap: 0.5rem;
  align-items: center;
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  border-radius: calc(var(--radius-md) - 4px);
  padding: 0.45rem;
  /* base depth only; brand border and glow appear on hover */
  box-shadow: 0 8px 30px rgba(0,0,0,0.45);
  /* Permanent deep-blue outer border */
  border: 3px solid var(--brand);
  transition: box-shadow var(--transition-med), border-color var(--transition-med);
  position: relative; /* needed for the decorative sparkling border */
  overflow: visible;  /* allow the decorative border to show outside */
}

.search-container:hover {
  border-color: var(--brand);
  box-shadow: 0 8px 30px rgba(0,0,0,0.45), var(--shadow-brand);
}

.search-container::after {
  content: "";
  pointer-events: none;
  position: absolute;
  inset: -2px; /* thin outer border */
  border-radius: calc(var(--radius-md) - 2px);
  /* toned-down deep-blue gradient: lower opacity and softer blur */
  background: linear-gradient(90deg, rgba(61,78,233,0.00) 0%, rgba(61,78,233,0.40) 50%, rgba(61,78,233,0.00) 100%);
  background-size: 200% 100%;
  filter: blur(4px);
  opacity: 0;
  transition: opacity var(--transition-fast) ease;
  z-index: 0; /* sit behind interactive controls (controls use z-index > 0) */
  mix-blend-mode: screen;
  animation: sparkleBorder 3500ms linear infinite;
}

.search-container:focus-within::after { opacity: 1; }

@keyframes sparkleBorder {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* stronger, slightly more intense blue glow when focused */
.search-container:focus-within {
  box-shadow:
    var(--shadow-brand),
    0 0 22px rgba(61,78,233,0.18),
    0 2px 12px rgba(61,78,233,0.10);
  outline: 2px solid rgba(61,78,233,0.06);
  transition: box-shadow var(--transition-med), outline var(--transition-med);
}

/* Thin gold sparkling border shown on focus to add subtle emphasis */
.search-container::after {
  content: "";
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  border-radius: calc(var(--radius-md) - 4px);
  pointer-events: none;
  opacity: 0;
  transition: opacity 220ms ease;
  box-shadow: 0 6px 30px rgba(61,78,233,0.03);
  background: linear-gradient(90deg, rgba(61,78,233,0.0) 0%, rgba(61,78,233,0.40) 40%, rgba(61,78,233,0.0) 80%);
  background-size: 200% 100%;
  mix-blend-mode: screen;
}
.search-container:focus-within::after {
  opacity: 0.65; /* reduce peak brightness on focus */
  animation: sparkleBorder 3500ms linear infinite;
}

/* Permanently show the decorative search border around the search container.
   This forces the ::after pseudo-element to be visible at all times (not only on hover/focus). */
.search-container::after {
  opacity: 0.65 !important;
}

@keyframes sparkleBorder {
  0% { background-position: 0% 50%; filter: saturate(1) hue-rotate(0deg); }
  50% { background-position: 100% 50%; filter: saturate(1.1) hue-rotate(8deg); }
  100% { background-position: 0% 50%; filter: saturate(1) hue-rotate(0deg); }
}

.search-bar {
