    <script>
/* Small WebAudio "click" when moving between select items.
   Plays only after a user gesture (to satisfy browser autoplay policies).
*/
document.addEventListener('DOMContentLoaded', function () {
  const selects = [
    document.getElementById('navigationSelect'),
    document.getElementById('languageSelect')
  ].filter(Boolean);

  if (!selects.length) return;

  // Create AudioContext once
  const AudioCtx = window.AudioContext || window.webkitAudioContext;
  const audioCtx = AudioCtx ? new AudioCtx() : null;
  let userInteracted = false;

  function enableSoundOnGesture() {
    userInteracted = true;
    if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
    window.removeEventListener('pointerdown', enableSoundOnGesture);
    window.removeEventListener('keydown', enableSoundOnGesture);
  }
  window.addEventListener('pointerdown', enableSoundOnGesture, { once: true });
  window.addEventListener('keydown', enableSoundOnGesture, { once: true });

  function playTick() {
    if (!audioCtx || !userInteracted) return;
    const now = audioCtx.currentTime;
    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.type = 'sine';
    o.frequency.setValueAtTime(1100, now);
    g.gain.setValueAtTime(0.0001, now);
    o.connect(g);
    g.connect(audioCtx.destination);
    o.start(now);
    g.gain.exponentialRampToValueAtTime(0.06, now + 0.01);
    g.gain.exponentialRampToValueAtTime(0.0001, now + 0.12);
    o.stop(now + 0.14);
  }

  // Attach handlers to each select:
  selects.forEach((sel) => {
    let lastIndex = sel.selectedIndex;

    // Play on change
    sel.addEventListener('change', () => {
      playTick();
      lastIndex = sel.selectedIndex;
    });

    // Play when using keyboard arrows (selection may change slightly after key event)
    sel.addEventListener('keydown', (e) => {
      if (['ArrowUp','ArrowDown','PageUp','PageDown','Home','End'].includes(e.key)) {
        setTimeout(() => {
          if (sel.selectedIndex !== lastIndex) {
            playTick();
            lastIndex = sel.selectedIndex;
          }
        }, 60);
      }
    });
  });

  /* Add near the end of the document, before the closing </body> */
(function () {
  const NAV_SELECTOR = '.top-nav .nav-links a';
  const SELECT_IDS = ['navigationSelect', 'languageSelect'];
  const STORAGE_PREFIX = 'menu_ts_';

  function nowISO() { return new Date().toISOString(); }
  function formatForDisplay(iso) {
    try {
      const d = new Date(iso);
      return d.toLocaleString([], { hour: '2-digit', minute: '2-digit', day: 'numeric', month: 'short', year: 'numeric' });
    } catch (e) {
      return iso;
    }
  }

  function storageKey(key) { return STORAGE_PREFIX + key; }

  // Render a timestamp badge next to a menu element (anchor or select option)
  function renderBadgeForAnchor(anchor, key) {
    if (!anchor) return;
    let span = anchor.querySelector('.menu-ts');
    if (!span) {
      span = document.createElement('span');
      span.className = 'menu-ts';
      anchor.appendChild(span);
    }
    const stored = localStorage.getItem(storageKey(key));
    span.textContent = stored ? formatForDisplay(stored) : '—';
    span.title = stored || '';
  }

  // Record timestamp for a key and update UI
  function recordTimestamp(key) {
    const ts = nowISO();
    localStorage.setItem(storageKey(key), ts);

    // update any matching anchors
    document.querySelectorAll(NAV_SELECTOR).forEach(a => {
      const href = a.getAttribute('href') || a.dataset.key || a.textContent.trim();
      if (href === key) renderBadgeForAnchor(a, key);
    });

    // update selects display (if needed)
    SELECT_IDS.forEach(id => {
      const sel = document.getElementById(id);
      if (!sel) return;
      // show timestamp on the select's selected option (append small text to label via aria)
      if (sel.value === key) {
        sel.setAttribute('data-last-activated', ts);
      }
    });

    console.log('Menu activated:', key, ts);
  }

  // Initialize: attach click listeners and render stored timestamps
  function init() {
    // Render existing timestamps for anchors
    document.querySelectorAll(NAV_SELECTOR).forEach(a => {
      const href = a.getAttribute('href') || a.dataset.key || a.textContent.trim();
      renderBadgeForAnchor(a, href);

      // On click, record timestamp (allow default navigation)
      a.addEventListener('click', (e) => {
        try { recordTimestamp(href); } catch (err) { /* ignore */ }
        // do not prevent default (keeps navigation behavior)
      });
    });

    // Hook selects (navigationSelect + languageSelect)
    SELECT_IDS.forEach(id => {
      const sel = document.getElementById(id);
      if (!sel) return;

      // Render timestamp next to the select (if previously activated)
      const selectedKey = String(sel.value || '').trim();
      if (selectedKey) {
        const stored = localStorage.getItem(storageKey(selectedKey));
        if (stored) sel.setAttribute('data-last-activated', stored);
      }

      sel.addEventListener('change', () => {
        const val = String(sel.value || '').trim();
        if (!val) return;
        recordTimestamp(val);
        // preserve existing navigation behavior in your code
      });

      // Optional: keyboard activation
      sel.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const val = String(sel.value || '').trim();
          if (val) recordTimestamp(val);
        }
      });
    });

    // Accessibility: on load, append a small accessible note for selects showing last activated time
    // This will be kept in aria-label to expose to screen readers
    document.querySelectorAll('select[id]').forEach(sel => {
      const val = String(sel.value || '').trim();
      if (!val) return;
      const stored = localStorage.getItem(storageKey(val));
      if (stored) {
        const note = ` Last activated: ${formatForDisplay(stored)}.`;
        const aria = sel.getAttribute('aria-label') || sel.id;
        sel.setAttribute('aria-label', aria + note);
      }
    });
  }

  // Run on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Expose helper for debugging
  window.__recordMenuTimestamp = recordTimestamp;
})();

 /* Unified behaviour: make 'Quick navigation' act exactly like 'Select a world language'
   - navigates in the same tab via location.href
   - shared keyboard support (Enter)
   - resets to placeholder after navigation
*/
(function () {
  const nav = document.getElementById('navigationSelect');
  const lang = document.getElementById('languageSelect');

  const selects = [nav, lang].filter(Boolean);
  if (!selects.length) return;

  function handleSelectChange() {
    const target = String(this.value || '').trim();
    if (!target) return;
    // Navigate in same tab for both selects
    window.location.href = target;
    // Reset to placeholder for quick reuse
    this.value = '';
  }

  selects.forEach(s => {
    s.addEventListener('change', handleSelectChange);
    s.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        handleSelectChange.call(s, e);
      }
    });
  });
})();

function createMessageEl(text, role, date = new Date()) {
  ensureYearSeparator(date);

  const row = document.createElement('div');
  row.className = 'message ' + (role === 'user' ? 'user' : 'bot');

  // New wrapper for avatar + bubble alignment
  const inner = document.createElement('div');
  inner.className = 'message-row-inner';

  // Avatar
  const avatar = document.createElement('div');
  avatar.className = 'message-avatar';
  avatar.textContent = role === 'user' ? 'You' : 'C';   // C for Claude

    // Bubble container
    const bubble = document.createElement('div');
    bubble.className = 'message-bubble';
    // Prepend chat emoji for user-originated prompts
    bubble.textContent = (role === 'user') ? `💬 ${text}` : text;

  const meta = document.createElement('div');
  meta.className = 'message-meta';

  // Robust time + short date formatting using Intl.DateTimeFormat (works across locales)
  try {
    const timeFormatter = new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    const time = timeFormatter.format(date);
    if (role === 'user') {
      meta.innerHTML = `<span class="message-author">You</span> ${time}`;
    } else {
      meta.textContent = time; // only show time
    }
  } catch (err) {
    const fallback = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    if (role === 'user') meta.innerHTML = `<span class="message-author">You</span> ${fallback}`;
    else meta.textContent = fallback;
  }

  inner.appendChild(avatar);
  inner.appendChild(bubble);
  row.appendChild(inner);
  row.appendChild(meta);

  return row;
}

