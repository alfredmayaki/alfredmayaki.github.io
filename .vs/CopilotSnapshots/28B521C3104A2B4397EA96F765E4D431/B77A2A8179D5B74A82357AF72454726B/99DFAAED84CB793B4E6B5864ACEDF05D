    // Track search queries for tag cloud (now using API client)
    async function trackSearch(query) {
      if (!query || query.trim().length === 0) return;

      console.log('🔍 Tracking search:', query);

      // Use API client (handles localStorage + API sync)
      const result = await SearchTrackerAPI.trackSearch(query);

      if (result.success) {
        console.log('✅ Search tracked:', result.source);
      } else {
        console.warn('⚠️ Search tracking failed:', result.error);
      }

      // Still track in Firebase if available (for backward compatibility)
      if (firebaseInitialized && window.FirebaseSearchTracking) {
        const stopWords = ['the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of', 'with', 'is', 'was', 'are', 'be', 'have', 'has', 'what', 'when', 'where', 'why', 'how', 'can', 'could', 'would', 'should', 'will'];
        const words = query.toLowerCase()
          .replace(/[^\w\s]/g, ' ')
          .split(/\s+/)
          .filter(word => word.length > 2 && !stopWords.includes(word));

        const keywords = {};
        words.forEach(word => {
          keywords[word] = (keywords[word] || 0) + 1;
        });

        window.FirebaseSearchTracking.trackSearchFirebase(query.trim(), keywords)
