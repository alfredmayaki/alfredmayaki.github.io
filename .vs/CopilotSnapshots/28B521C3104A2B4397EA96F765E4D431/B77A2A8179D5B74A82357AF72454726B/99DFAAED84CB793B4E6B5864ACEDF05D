<script>
  (function initTypedPlaceholder() {
    try {
      function startTyped() {
        try {
          // Prefer exact input by id to avoid selecting wrappers or other elements
          const inputEl = document.getElementById('searchInput') || document.querySelector('.search-bar');
          if (!inputEl) return;
          if (inputEl.__typedInitialized) return;
          inputEl.__typedInitialized = true;

          // Use matchMedia for reliable viewport detection on mobile devices
          const isNarrow = (typeof window !== 'undefined' && window.matchMedia) ? window.matchMedia('(max-width: 420px)').matches : (window.innerWidth <= 420);

          const typedStrings = isNarrow ? [
            'Deploying my GitHub app',
            'Using Activity To Go',
            'Securely setting API keys via CLI',
            'Backing up Llama 3 project'
          ] : [
            "How do I deploy my GitHub web app?",
            "Explain Heroku's Activity To Go extension.",
            "How do I securely set up my API key in Heroku CLI?",
            'Where can I backup my Llama 3 project?',
            'What does GDPR have to do with data privacy?',
            'How can I improve my website SEO ranking?',
            'Tips for optimizing web app performance?',
            'Best practices for responsive web design?'

          ];

          // Use the selector string so Typed internally queries the element and sets the placeholder attr reliably
          const selector = '#searchInput';

          const opts = {
            strings: typedStrings,
            typeSpeed: 20,
            backSpeed: 15,
            backDelay: 1500,
            loop: true,
            attr: 'placeholder',
            bindInputFocusEvents: true,
            showCursor: false
          };

          // Initialize Typed using the selector; guard against errors
          try {
            new Typed(selector, opts);
          } catch (err) {
            // Fallback: try with the DOM element directly
            try { new Typed(inputEl, opts); } catch (err2) { console.warn('Typed initialization failed', err2); }
          }
        } catch (e) { console.warn('Typed placeholder start failed', e); }
      }

      if (typeof Typed === 'function') {
        startTyped();
      } else {
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://cdn.jsdelivr.net/npm/typed.js@2.0.12';
        s.onload = function () {
          try { startTyped(); } catch (e) { console.warn('startTyped after load failed', e); }
        };
        s.onerror = function () { console.warn('Failed to load Typed.js'); };
        document.head.appendChild(s);
      }
    } catch (err) { console.warn('Typed placeholder init failed', err); }
  })();
</script>
