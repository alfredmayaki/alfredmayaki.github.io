  <!-- Chat cache configuration and lightweight IndexedDB helper
       Exposes window.CHAT_DB_NAME, window.CHAT_DB_STORE and window.ChatDB
       Usage: await window.ChatDB.saveMessage({ role: 'user'|'bot', text: '...', timestamp: ISOString })
  -->
  <script>
    window.CHAT_DB_NAME = 'alfred_chat_db_v1';
    window.CHAT_DB_STORE = 'messages';

    (function () {
      const DB = window.CHAT_DB_NAME;
      const STORE = window.CHAT_DB_STORE;

      function openDB() {
        return new Promise((resolve, reject) => {
          try {
            const req = indexedDB.open(DB, 1);
            req.onupgradeneeded = function (e) {
              const db = e.target.result;
              if (!db.objectStoreNames.contains(STORE)) {
                db.createObjectStore(STORE, { keyPath: 'id', autoIncrement: true });
              }
            };
            req.onsuccess = function () { resolve(req.result); };
            req.onerror = function () { reject(req.error || new Error('IndexedDB open error')); };
          } catch (err) {
            reject(err);
          }
        });
      }

      async function saveMessage(entry) {
        const db = await openDB();
        return new Promise((resolve, reject) => {
          try {
            const tx = db.transaction(STORE, 'readwrite');
            tx.objectStore(STORE).add(entry);
            tx.oncomplete = function () { db.close(); resolve(); };
            tx.onerror = function () { db.close(); reject(tx.error || new Error('Transaction error')); };
          } catch (err) { reject(err); }
        });
      }

      async function getAllMessages() {
        const db = await openDB();
        return new Promise((resolve, reject) => {
          try {
            const tx = db.transaction(STORE, 'readonly');
            const req = tx.objectStore(STORE).getAll();
            req.onsuccess = function () { db.close(); resolve(req.result || []); };
            req.onerror = function () { db.close(); reject(req.error || new Error('getAll error')); };
          } catch (err) { reject(err); }
        });
      }

      async function clearMessages() {
        const db = await openDB();
        return new Promise((resolve, reject) => {
          try {
            const tx = db.transaction(STORE, 'readwrite');
            tx.objectStore(STORE).clear();
            tx.oncomplete = function () { db.close(); resolve(); };
            tx.onerror = function () { db.close(); reject(tx.error || new Error('clear error')); };
          } catch (err) { reject(err); }
        });
      }

      // Expose a minimal API for other scripts to use
      window.ChatDB = {
        openDB,
        saveMessage,
        getAllMessages,
        clearMessages
      };
    })();
  </script>

