  <style>
    :root{
      --font-sans: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
      --bg-overlay: rgba(255,255,255,0.92);
      --panel: #f5f5f5;
      --surface: #e8e8e8;
      --text: #1a1a1a;
      --text-muted: #666666;
      --text-secondary: #4a4a4a;
      --border: #d0d0d0;
      --brand: #3d4ee9;
      --brand-hover: #5563f0;
      --radius-md: 14px;
      --radius-lg: 18px;
      --shadow-pop: 0 10px 30px rgba(0,0,0,0.1);
      --transition-fast: 180ms;
      --transition-med: 300ms;
    }

    html {
      background: #FFFFFF;
      min-height: 100vh;
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-sans);
      background: #FFFFFF;
      color: var(--text-muted);
      line-height: 1.6;
      font-size: 16px;
      max-width: 990px;
      margin: 2em auto;
      padding: 2em;
      border: 3px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-pop);
      box-sizing: border-box;
    }

    /* ---------- Top navigation with hamburger dropdown ---------- */
    .top-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      max-width: 980px;
      margin: 0 auto 1.25rem;
      padding: 0.45rem 0.6rem;
      background: transparent;
      box-sizing: border-box;
      position: relative;
    }
    .top-nav .brand {
      color: var(--text);
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.98rem;
      z-index: 10;
    }
    .top-nav .brand:link,
    .top-nav .brand:visited,
    .top-nav .brand:hover,
    .top-nav .brand:active {
      color: var(--text);
      text-decoration: none;
    }
    /* Hamburger menu button */
    .menu-toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      width: 44px;
      height: 44px;
      padding: 0.5rem;
      background: var(--surface);
      border: 2px solid var(--border);
      border-radius: 10px;
      cursor: pointer;
      transition: background var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
      z-index: 10;
    }
    .menu-toggle:hover,
    .menu-toggle:focus {
      background: rgba(61,78,233,0.08);
      border-color: var(--brand);
      box-shadow: 0 6px 20px rgba(61,78,233,0.12);
      outline: none;
    }
    .menu-toggle .bar {
      width: 20px;
      height: 2px;
      background: var(--text);
      margin: 2px 0;
      border-radius: 2px;
      transition: transform var(--transition-fast), opacity var(--transition-fast);
    }
    .menu-toggle.open .bar:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .menu-toggle.open .bar:nth-child(2) { opacity: 0; }
    .menu-toggle.open .bar:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
    /* Dropdown menu box */
    .nav-dropdown {
      position: absolute;
      top: 100%;
      right: 0;
      min-width: 200px;
      background: var(--panel);
      border: 2px solid var(--brand);
      border-radius: 12px;
      padding: 0.5rem;
      box-shadow: 0 12px 40px rgba(0,0,0,0.5), 0 6px 20px rgba(61,78,233,0.12);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity var(--transition-med), transform var(--transition-med), visibility var(--transition-med);
      z-index: 100;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .nav-dropdown.open {
      opacity: 1;
      visibility: visible;
      transform: translateY(8px);
    }
    .nav-dropdown a {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-secondary);
      text-decoration: none;
      padding: 0.65rem 0.9rem;
      border-radius: 8px;
      font-size: 0.95rem;
      transition: background var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
    }
    .nav-dropdown a:hover,
    .nav-dropdown a:focus {
      background: rgba(61,78,233,0.12);
      color: var(--text);
      transform: translateX(4px);
      outline: none;
    }
    .nav-dropdown a[aria-current="page"] {
      background: rgba(61,78,233,0.15);
      color: var(--brand);
      font-weight: 600;
    }
    .nav-dropdown .menu-label {
      color: var(--text-muted);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.4rem 0.9rem 0.2rem;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      margin-bottom: 0.25rem;
    }
    @media (max-width: 600px) {
      .top-nav { padding: 0.4rem; }
      .nav-dropdown { right: 0; left: 0; min-width: auto; margin: 0 0.4rem; }
    }

    .page-title { text-align:center; color:var(--text); font-size:1.25rem; font-weight:700; margin:0.75rem 0 0.6rem; }
    .page-subtitle { color:#9b9b9b; font-family:Arial,Helvetica,sans-serif; text-align:center; margin:0.25rem 0 1rem; font-weight:600; }

    .content {
      max-width: 920px;
      margin: 1.25rem auto;
      background: rgba(255,255,255,0.02);
      border-radius: 12px;
      padding: 1.25rem;
      color: var(--text-secondary);
      box-sizing: border-box;
      border-left: 4px solid transparent;
      transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    }

    .content:hover {
      border-left-color: var(--brand);
      box-shadow: 0 8px 24px rgba(61,78,233,0.06);
    }

    .section-title { color: var(--text); margin: 0.25rem 0 0.65rem; font-size: 1.02rem; font-weight: 700; }
    .project-list { display: grid; gap: 1rem; list-style: none; padding: 0; margin: 0; }
    .project {
      background: linear-gradient(180deg, rgba(255,255,255,0.01), transparent);
      border: 1px solid rgba(255,255,255,0.03);
      padding: 0.9rem;
      border-radius: 10px;
      color: var(--text-secondary);
    }
    .project h3 { margin: 0 0 0.25rem 0; color: var(--text); font-size: 1rem; }
    .meta { font-size: 0.92rem; color: var(--text-secondary); margin-bottom: 0.5rem; }
    .project p { margin: 0.45rem 0; }
    .project a { color: var(--brand); text-decoration: none; }
    .project a:hover, .project a:focus { color: var(--brand-hover); text-decoration: underline; }

    .soft-separator { border:none; height:1px; margin:1.5rem 0; width:100%; background: linear-gradient(90deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02)); opacity:0.85; }

    /* Footer */
    .site-footer { padding: 1.25rem 0; margin-top: 2.5rem; text-align:center; }
    .footer-links { display:inline-flex; gap:0.5rem; align-items:center; justify-content:center; flex-wrap:wrap; padding:0; margin:0 0 0.6rem 0; list-style:none; }
    .footer-links a { color: var(--text); text-decoration:none; padding: 0.25rem 0.6rem; }
    .footer-links a:hover { color: var(--brand); transform: translateY(-4px); }
    .footer-copyright { color: var(--text-muted); font-size: 0.9em; margin:0; }

    @media (max-width: 680px) {
      .content { padding: 0.9rem; }
    }
  </style>
