<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Projects — AM Global</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="Projects and community work by Alfred Anate Bodurin Mayaki — BipolarUK and Central London Meetup (Co-Facilitator)." />
