# ===================================
# MSC Survey - Google OAuth & Sheets Configuration
# ===================================
# 
# IMPORTANT: This file contains sensitive credentials.
# NEVER commit this file to version control.
# Add .env to your .gitignore file.
#
# How to obtain these credentials:
#
# 1. GOOGLE_CLIENT_ID
#    - Go to https://console.cloud.google.com/
#    - Create a new project
#    - Go to "Credentials" in the left menu
#    - Click "Create Credentials" > "OAuth 2.0 Client ID"
#    - Choose "Web application"
#    - Add authorized redirect URIs:
#      * http://localhost:3000 (for local testing)
#      * https://alfredmayaki.me (for production)
#    - Copy the Client ID
#    
# 2. GOOGLE_SHEET_ID
#    - Create a new Google Sheet
#    - Copy the ID from the URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
#    
# 3. GOOGLE_API_KEY
#    - In Google Cloud Console, go to Credentials
#    - Create an API Key (restricted to Google Sheets API)
#    - Copy the API Key
#    
# 4. BACKEND_URL
#    - Set to your backend service URL (Firebase Cloud Functions, etc.)
#    - Example: https://us-central1-your-project.cloudfunctions.net
#
# ===================================

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here

# Google Sheets API Key (restricted)
GOOGLE_API_KEY=your_google_api_key_here

# Google Sheet ID for storing responses
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Backend URL for secure API calls
# This backend handles Google Sheets API calls with server-side credentials
BACKEND_URL=https://your-backend-url.com

# Node Environment
NODE_ENV=production

# ===================================
# SECURITY NOTES
# ===================================
# 
# 1. Keep this file PRIVATE
#    - Never commit to GitHub
#    - Never share publicly
#    - Only share with authorized team members
#
# 2. Use different credentials for different environments
#    - Development: Local credentials with localhost redirect
#    - Production: Production credentials with your domain
#
# 3. Rotate credentials regularly
#    - Change API keys every 3-6 months
#    - Revoke old credentials immediately
#
# 4. API Key Restrictions
#    - Restrict API key to Google Sheets API only
#    - Add HTTP referer restrictions
#    - Set usage quotas
#
# 5. OAuth Scopes
#    - Only request necessary scopes
#    - For this app: userinfo.profile, userinfo.email
#    - Do NOT use offline access unless needed
#
# ===================================
